</Layout>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  const luxuryEase = CustomEase.create('luxuryEaseCustom', '0.16, 1, 0.3, 1')

  function animateHeadingLines(
    linesSelector: string,
    charSelector: string,
    triggerElement?: HTMLElement | string | null,
    delay: number = 0
  ) {
    const lines = Array.from(document.querySelectorAll<HTMLElement>(linesSelector))
    if (!lines.length) return

    const allChars = lines.flatMap((l) => Array.from(l.querySelectorAll<HTMLElement>(charSelector)))
    if (!allChars.length) return

    gsap.set(allChars, {
      yPercent: 115,
      opacity: 0,
      filter: 'blur(5px)',
    })

    const tlConfig: gsap.TimelineVars = {}
    if (triggerElement) {
      tlConfig.scrollTrigger = {
        trigger: triggerElement,
        start: 'top 85%',
        once: true,
      }
    } else {
      tlConfig.delay = delay
    }

    const tl = gsap.timeline(tlConfig)

    lines.forEach((line, lineIndex) => {
      const chars = Array.from(line.querySelectorAll<HTMLElement>(charSelector))
      const centerIdx = (chars.length - 1) / 2
      const lineStartDelay = lineIndex * 0.095

      chars.forEach((char, charIdx) => {
        const distFromCenter = Math.abs(charIdx - centerIdx)
        const waveDelay = lineStartDelay + (distFromCenter * 0.024)

        tl.to(
          char,
          {
            yPercent: 0,
            opacity: 1,
            filter: 'blur(0px)',
            duration: 1.6,
            ease: luxuryEase,
          },
          waveDelay
        )
      })
    })
  }

  function initGifting() {
    // 1. Hero: "THE GIFT CRATE" animates on page load
    animateHeadingLines('.gift-hero-line', '.gift-hero-char', null, 0.15)

    // 2. Section 2: Cards titles on scroll
    animateHeadingLines('.gift-card-title-line', '.gift-card-char', '.crate-card')

    // 3. Section 4: "FOR FIRMS AND FAMILIES WITH LISTS." on scroll
    animateHeadingLines('.gift-firms-line', '.gift-firms-char', '#firms-heading')

    const cards = document.querySelectorAll('.crate-card')
    const noteElems = document.querySelectorAll('.note-text-elem')
    const firmElems = document.querySelectorAll('.firms-anim-elem')

    // Always ensure elements are visible by default on all devices
    cards.forEach((c) => gsap.set(c, { opacity: 1, y: 0 }))
    noteElems.forEach((n) => gsap.set(n, { opacity: 1, y: 0 }))
    firmElems.forEach((f) => gsap.set(f, { opacity: 1, y: 0 }))

    if (window.innerWidth >= 1024) {
      if (noteElems.length > 0) {
        ScrollTrigger.create({
          trigger: noteElems[0],
          start: 'top 85%',
          once: true,
          onEnter: () => {
            gsap.from(noteElems, { opacity: 0, y: 30, duration: 0.8, stagger: 0.1, ease: 'power3.out' })
          },
        })
      }

      if (firmElems.length > 0) {
        ScrollTrigger.create({
          trigger: firmElems[0],
          start: 'top 85%',
          once: true,
          onEnter: () => {
            gsap.from(firmElems, { opacity: 0, y: 30, duration: 0.8, stagger: 0.08, ease: 'power3.out' })
          },
        })
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGifting)
  } else {
    initGifting()
  }
  document.addEventListener('astro:page-load', initGifting)
</script>
