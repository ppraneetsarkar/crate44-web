                  </div>

                  <!-- Card Title -->
                  <h2 class="mt-[18px] sm:mt-[22px] md:mt-[24px] mb-[8px] md:mb-[12px] flex flex-col p-0 uppercase select-none">
                    <span class="block overflow-hidden pb-[0.05em]">
                      <span class="gift-card-title-line flex flex-nowrap whitespace-nowrap text-[#FBF9D6] font-display text-[44px] sm:text-[52px] md:text-[68px] lg:text-[84px] xl:text-[96px] 2xl:text-[112px] font-semibold leading-[42px] sm:leading-[50px] md:leading-[64px] lg:leading-[80px] xl:leading-[90px] 2xl:leading-[100px] tracking-[0.8px] uppercase">
                        {crate.titleLine1.split('').map((c) => (
                          <span class="gift-card-char inline-block will-change-transform">{c === ' ' ? '\u00A0' : c}</span>
                        ))}
                      </span>
                    </span>
                    <span class="block overflow-hidden pb-[0.05em]">
                      <span class="gift-card-title-line flex flex-nowrap whitespace-nowrap text-[#FBF9D6] font-display text-[44px] sm:text-[52px] md:text-[68px] lg:text-[84px] xl:text-[96px] 2xl:text-[112px] font-semibold leading-[42px] sm:leading-[50px] md:leading-[64px] lg:leading-[80px] xl:leading-[90px] 2xl:leading-[100px] tracking-[0.8px] uppercase">
                        {crate.titleLine2.split('').map((c) => (
                          <span class="gift-card-char inline-block will-change-transform">{c === ' ' ? '\u00A0' : c}</span>
                        ))}
                      </span>
                    </span>
                  </h2>

                  <!-- Description & Price -->
                  <div class="w-full">
                    <p class="m-0 font-body text-[#FBF9D6] text-[16px] sm:text-[18px] font-medium leading-[22px]">
                      <span>{crate.desc} </span>
                      <span class="font-bold">{crate.price}</span>
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: The Note (Hand-written, never printed) -->
    <section class="w-full bg-[#111111] py-[50px] sm:py-[60px] lg:py-[80px] overflow-hidden">
      <div class="px-4 lg:px-8 w-full">
        <div class="w-full mx-auto flex flex-col lg:flex-row items-center justify-between gap-[32px] lg:gap-[64px]">
          <!-- Interactive Note Canvas / Card -->
          <div class="w-full lg:w-[50%] flex justify-center items-center order-1 lg:order-2">
            <div
              id="note-canvas-container"
              class="relative w-full max-w-[480px] lg:max-w-[602px] h-[360px] sm:h-[440px] md:h-[540px] lg:h-[612px] flex items-center justify-center select-none"
            >
              <img
                src="/webp/note-card.webp"
                alt="Hand-written Crate 44 Note Card"
                class="w-full h-auto max-h-full object-contain filter drop-shadow-[0_20px_40px_rgba(252,85,141,0.25)] hover:scale-105 transition-transform duration-500 ease-out"
              />
            </div>
          </div>

          <!-- Text Copy -->
          <div class="w-full lg:w-[50%] flex flex-col items-start justify-start order-2 lg:order-1 mt-4 lg:mt-0">
            <span class="note-text-elem mb-4 sm:mb-8 block text-[#FBF9D6] font-body text-[14px] sm:text-[16px] font-medium leading-[20px]">
              The Note
            </span>
            <h2 class="note-text-elem m-0">
              <span
                class="block text-[#FBF9D6] font-body text-[32px] sm:text-[42px] md:text-[50px] lg:text-[56px] font-bold leading-[38px] sm:leading-[50px] md:leading-[60px] lg:leading-[64px] tracking-[-0.358px]"
              >
                Hand-written, never printed<br />
                Twelve words carry better<br />
                than two hundred
              </span>
            </h2>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: FOR FIRMS AND FAMILIES WITH LISTS -->
    <section class="w-full bg-[#111111] py-[50px] sm:py-[60px] lg:py-[80px] overflow-hidden">
      <div class="px-4 lg:px-8 w-full">
        <div class="w-full mx-auto flex flex-col">
          <div class="w-full mb-[16px] lg:mb-[24px]">
            <span class="firms-anim-elem block text-[#FBF9D6] font-body text-[14px] sm:text-[16px] font-medium leading-[20px]">
              Corporate & weddings
            </span>
          </div>

          <!-- Giant Headline -->
          <div id="firms-heading" class="w-full mb-[32px] lg:mb-[56px] flex flex-col items-start overflow-hidden select-none">
            <h2 class="m-0 p-0 w-full uppercase flex flex-col">
              <span class="block overflow-hidden pb-[0.05em]">
                <span
                  class="gift-firms-line flex flex-nowrap whitespace-nowrap uppercase font-display text-[72px] sm:text-[100px] md:text-[140px] lg:text-[180px] 2xl:text-[200px] font-semibold leading-[64px] sm:leading-[90px] md:leading-[120px] lg:leading-[150px] 2xl:leading-[161.2px] tracking-[0.8px]"
                  style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                  data-line="FOR FIRMS AND"
                >
                  <span class="gift-firms-char inline-block will-change-transform">F</span>
                  <span class="gift-firms-char inline-block will-change-transform">O</span>
                  <span class="gift-firms-char inline-block will-change-transform">R</span>
                  <span class="gift-firms-char inline-block will-change-transform">&nbsp;</span>
                  <span class="gift-firms-char inline-block will-change-transform">F</span>
                  <span class="gift-firms-char inline-block will-change-transform">I</span>
                  <span class="gift-firms-char inline-block will-change-transform">R</span>
                  <span class="gift-firms-char inline-block will-change-transform">M</span>
                  <span class="gift-firms-char inline-block will-change-transform">S</span>
                  <span class="gift-firms-char inline-block will-change-transform">&nbsp;</span>
                  <span class="gift-firms-char inline-block will-change-transform">A</span>
                  <span class="gift-firms-char inline-block will-change-transform">N</span>
                  <span class="gift-firms-char inline-block will-change-transform">D</span>
                </span>
              </span>
              <span class="block overflow-hidden pb-[0.05em]">
                <span
                  class="gift-firms-line flex flex-nowrap whitespace-nowrap uppercase font-display text-[72px] sm:text-[100px] md:text-[140px] lg:text-[180px] 2xl:text-[200px] font-semibold leading-[64px] sm:leading-[90px] md:leading-[120px] lg:leading-[150px] 2xl:leading-[161.2px] tracking-[0.8px]"
                  style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                  data-line="FAMILIES WITH LISTS."
                >
                  <span class="gift-firms-char inline-block will-change-transform">F</span>
                  <span class="gift-firms-char inline-block will-change-transform">A</span>
                  <span class="gift-firms-char inline-block will-change-transform">M</span>
                  <span class="gift-firms-char inline-block will-change-transform">I</span>
                  <span class="gift-firms-char inline-block will-change-transform">L</span>
                  <span class="gift-firms-char inline-block will-change-transform">I</span>
                  <span class="gift-firms-char inline-block will-change-transform">E</span>
                  <span class="gift-firms-char inline-block will-change-transform">S</span>
                  <span class="gift-firms-char inline-block will-change-transform">&nbsp;</span>
                  <span class="gift-firms-char inline-block will-change-transform">W</span>
                  <span class="gift-firms-char inline-block will-change-transform">I</span>
                  <span class="gift-firms-char inline-block will-change-transform">T</span>
                  <span class="gift-firms-char inline-block will-change-transform">H</span>
                  <span class="gift-firms-char inline-block will-change-transform">&nbsp;</span>
                  <span class="gift-firms-char inline-block will-change-transform">L</span>
                  <span class="gift-firms-char inline-block will-change-transform">I</span>
                  <span class="gift-firms-char inline-block will-change-transform">S</span>
                  <span class="gift-firms-char inline-block will-change-transform">T</span>
                  <span class="gift-firms-char inline-block will-change-transform">S</span>
                  <span class="gift-firms-char inline-block will-change-transform">.</span>
                </span>
              </span>
            </h2>
          </div>

          <!-- Bottom Columns -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-y-[32px] gap-x-[64px] w-full">
            <div class="w-full flex flex-col justify-end">
              <p class="firms-anim-elem m-0">
                <span
                  class="font-body text-[24px] sm:text-[28px] lg:text-[32px] font-bold leading-[30px] sm:leading-[34px] lg:leading-[38px] tracking-[-0.32px]"
                  style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                >
                  Fifty crates or five hundred same table, same standard, one contact.
                </span>
              </p>
            </div>

            <div class="w-full flex flex-col justify-start">
              <span class="firms-anim-elem block text-[#FBF9D6] font-body text-[14px] sm:text-[16px] font-medium leading-[20px] mb-2 sm:mb-4">
                The Honest Rules
              </span>
              <p class="firms-anim-elem m-0 text-[#FF9CBE] font-body text-[26px] sm:text-[34px] md:text-[42px] lg:text-[50px] font-bold leading-[32px] sm:leading-[42px] md:leading-[52px] lg:leading-[60px] tracking-[-0.358px]">
                We deliver in Mumbai. We need 48 hours for gift crates. And we won't ship what won't survive shipping — if your date falls badly for a fruit, we'll tell you and propose better.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Global Footer -->
    <Footer />
