---
// src/components/Footer.astro
// Exact implementation of "THE LIST IS SMALL ON PURPOSE" section & Global Footer from crate44.in

interface Props {
  showTheList?: boolean
}

const { showTheList = true } = Astro.props
---

<!-- ============================================================== -->
<!-- 1. SECTION: THE LIST IS SMALL ON PURPOSE (#the-list)           -->
<!-- ============================================================== -->
{showTheList && (
<section
  id="the-list"
  class="relative w-full min-h-screen bg-[#131313] flex items-center py-[56px] lg:py-[64px] overflow-hidden"
  style="--x: 50%; --y: 50%;"
  aria-label="The List"
>
  <!-- ============================================================== -->
  <!-- DESKTOP / WEB LAYOUT (hidden lg:flex) - 2-COLUMN STRUCTURE     -->
  <!-- ============================================================== -->
  <div class="hidden lg:flex px-4 lg:px-8 w-full relative z-10">
    <div class="w-full mx-auto h-full flex flex-row items-end justify-between gap-8">
      <!-- Left Column: Split Heading & Centered Parallax Image -->
      <div class="flex flex-col items-start w-auto">
        <!-- Top Text Block -->
        <div class="top-text-block w-full will-change-transform z-10">
          <h2
            class="flex flex-col items-start uppercase text-[clamp(60px,13.88vw,200px)] leading-[0.81] tracking-[0.48px] font-display font-semibold"
          >
            <div class="overflow-hidden pb-1">
              <span
                class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                data-line="THE LIST"
              >
                <span class="the-list-char inline-block">T</span>
                <span class="the-list-char inline-block">H</span>
                <span class="the-list-char inline-block">E</span>
                <span class="the-list-char inline-block">&nbsp;</span>
                <span class="the-list-char inline-block">L</span>
                <span class="the-list-char inline-block">I</span>
                <span class="the-list-char inline-block">S</span>
                <span class="the-list-char inline-block">T</span>
              </span>
            </div>
          </h2>
        </div>

        <!-- Parallax Aperture Image Container (Desktop: aspect-[474/273]) -->
        <div class="the-list-image-container relative w-full max-w-[474px] my-4 lg:my-11 z-0">
          <div
            class="curve-straight relative w-full aspect-[474/273] overflow-hidden shadow-2xl shrink-0 the-list-image-card will-change-[clip-path]"
            data-curve="straight"
          >
            <img
              src="/images/the-list/the-list-stall.webp"
              alt="Premium Produce"
              class="the-list-image-photo absolute inset-x-0 -top-[8%] w-full h-[116%] object-cover block will-change-transform transition-transform duration-700 ease-out hover:scale-105"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <!-- Subtle gradient blend overlay to smooth into #131313 -->
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#131313]/35 via-transparent to-[#131313]/20"
            ></div>
            <div class="absolute inset-0 pointer-events-none rounded-[inherit] ring-1 ring-inset ring-white/10"></div>
          </div>
        </div>

        <!-- Bottom Text Block -->
        <div class="bottom-text-block w-full will-change-transform z-10">
          <h2
            class="flex flex-col items-start uppercase text-[clamp(60px,13.88vw,200px)] leading-[0.81] tracking-[0.48px] font-display font-semibold"
          >
            <div class="overflow-hidden pb-1">
              <span
                class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                data-line="IS SMALL"
              >
                <span class="the-list-char inline-block">I</span>
                <span class="the-list-char inline-block">S</span>
                <span class="the-list-char inline-block">&nbsp;</span>
                <span class="the-list-char inline-block">S</span>
                <span class="the-list-char inline-block">M</span>
                <span class="the-list-char inline-block">A</span>
                <span class="the-list-char inline-block">L</span>
                <span class="the-list-char inline-block">L</span>
              </span>
            </div>
            <div class="overflow-hidden pb-1">
              <span
                class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                data-line="ON PURPOSE"
              >
                <span class="the-list-char inline-block">O</span>
                <span class="the-list-char inline-block">N</span>
                <span class="the-list-char inline-block">&nbsp;</span>
                <span class="the-list-char inline-block">P</span>
                <span class="the-list-char inline-block">U</span>
                <span class="the-list-char inline-block">R</span>
                <span class="the-list-char inline-block">P</span>
                <span class="the-list-char inline-block">O</span>
                <span class="the-list-char inline-block">S</span>
                <span class="the-list-char inline-block">E</span>
              </span>
            </div>
          </h2>
        </div>
      </div>

      <!-- Right Column: Paragraph & 3D Flip Perspective Button -->
      <div class="flex flex-col items-start gap-8 w-[380px] shrink-0">
        <p
          class="the-list-para will-change-transform text-[16px] leading-[20px] tracking-[-0.4px] text-[#FBF9D6] font-body font-semibold max-w-[343px]"
        >
          We serve a limited number of Mumbai households each season it's the only way the standard survives. If the list is full, we'll tell you honestly and hold your place.
        </p>
        <div class="the-list-btn will-change-transform shrink-0 w-max">
          <a
            href="https://wa.me/?text=Hi%20Crate44%2C%20I%20would%20like%20to%20join%20the%20list"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-btn-morph bg-[#F8FE03] text-[#131313] border border-[#F8FE03] rounded-full relative inline-flex items-center justify-center text-center uppercase font-display font-semibold text-[32px] leading-[34px] px-6 md:px-8 py-2 active:scale-95 flex-shrink-0 transition-[background-color,filter] duration-300 hover:brightness-105 will-change-[border-radius]"
          >
            <span
              class="roll-fx-container relative block h-[34px] leading-[34px] overflow-hidden select-none"
              style="-webkit-mask-image: linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%);"
            >
              <span class="roll-text-top block h-[34px] leading-[34px] whitespace-nowrap will-change-[transform,filter]">
                JOIN THE LIST
              </span>
              <span class="roll-text-bottom absolute inset-0 flex items-center justify-center h-[34px] leading-[34px] whitespace-nowrap will-change-[transform,filter]">
                JOIN THE LIST
              </span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MOBILE LAYOUT (lg:hidden) - EXACT SECTION 6 ARCHITECTURE        -->
  <!-- ============================================================== -->
  <div class="lg:hidden flex flex-col w-full items-start px-4 z-10">
    
    <!-- 1. TOP: Giant Headline (Scaled to margins edge-to-edge to widest line 'ON PURPOSE') -->
    <div class="the-list-headline-mobile w-full flex flex-col items-start select-none mb-6">
      <!-- Line 1: THE LIST -->
      <div class="the-list-mask overflow-hidden py-1 w-full">
        <div
          class="the-list-reveal-line flex flex-nowrap whitespace-nowrap justify-start font-display font-semibold uppercase text-[clamp(64px,24vw,100px)] leading-[calc(90/115)] tracking-[-0.004em] text-left"
          data-line="THE LIST"
          style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
        >
          <span class="the-list-char inline-block">T</span>
          <span class="the-list-char inline-block">H</span>
          <span class="the-list-char inline-block">E</span>
          <span class="the-list-char inline-block">&nbsp;</span>
          <span class="the-list-char inline-block">L</span>
          <span class="the-list-char inline-block">I</span>
          <span class="the-list-char inline-block">S</span>
          <span class="the-list-char inline-block">T</span>
        </div>
      </div>

      <!-- Line 2: IS SMALL -->
      <div class="the-list-mask overflow-hidden py-1 w-full">
        <div
          class="the-list-reveal-line flex flex-nowrap whitespace-nowrap justify-start font-display font-semibold uppercase text-[clamp(64px,24vw,100px)] leading-[calc(90/115)] tracking-[-0.004em] text-left"
          data-line="IS SMALL"
          style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
        >
          <span class="the-list-char inline-block">I</span>
          <span class="the-list-char inline-block">S</span>
          <span class="the-list-char inline-block">&nbsp;</span>
          <span class="the-list-char inline-block">S</span>
          <span class="the-list-char inline-block">M</span>
          <span class="the-list-char inline-block">A</span>
          <span class="the-list-char inline-block">L</span>
          <span class="the-list-char inline-block">L</span>
        </div>
      </div>

      <!-- Line 3: ON PURPOSE -->
      <div class="the-list-mask overflow-hidden py-1 w-full">
        <div
          class="the-list-reveal-line flex flex-nowrap whitespace-nowrap justify-start font-display font-semibold uppercase text-[clamp(64px,24vw,100px)] leading-[calc(90/115)] tracking-[-0.004em] text-left"
          data-line="ON PURPOSE"
          style="background-image: linear-gradient(180deg, #3ED5FF 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
        >
          <span class="the-list-char inline-block">O</span>
          <span class="the-list-char inline-block">N</span>
          <span class="the-list-char inline-block">&nbsp;</span>
          <span class="the-list-char inline-block">P</span>
          <span class="the-list-char inline-block">U</span>
          <span class="the-list-char inline-block">R</span>
          <span class="the-list-char inline-block">P</span>
          <span class="the-list-char inline-block">O</span>
          <span class="the-list-char inline-block">S</span>
          <span class="the-list-char inline-block">E</span>
        </div>
      </div>
    </div>

    <!-- 2. MIDDLE: Image Card (Center, Strictly 4:4 / 1:1 square ratio matching Section 6 mobile) -->
    <div class="the-list-image-col-mobile relative w-full mb-6 flex items-center justify-center">
      <div
        class="the-list-image-card-mob group relative w-full aspect-square max-w-[440px] overflow-hidden bg-white/5 border border-white/5 shadow-md will-change-[clip-path]"
      >
        <picture>
          <source srcset="/images/the-list/the-list-stall.webp" type="image/webp" />
          <img
            src="/images/the-list/the-list-stall.webp"
            alt="Crate44 stall"
            class="the-list-image-photo-mob absolute inset-x-0 -top-[8%] w-full h-[116%] object-cover block will-change-transform transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </picture>
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#131313]/35 via-transparent to-[#131313]/20"
        ></div>
        <div class="absolute inset-0 pointer-events-none rounded-[inherit] ring-1 ring-inset ring-white/10"></div>
      </div>
    </div>

    <!-- 3. BOTTOM: Subtext & Button (Stacked vertically, hugging closely) -->
    <div class="the-list-bottom-col-mobile w-full flex flex-col items-start text-left gap-4 pb-8">
      <!-- Subtext (Suisse Intl: 14px, 17px line-height, 600 weight, -0.4px kerning) -->
      <p
        class="the-list-para font-body font-semibold text-[14px] leading-[17px] tracking-[-0.4px] text-white max-w-[340px] m-0 text-left"
      >
        We serve a limited number of Mumbai households each season it's the only way the standard survives. If the list is full, we'll tell you honestly and hold your place.
      </p>

      <!-- Button: JOIN THE LIST Mobile (Solo Button: Morphs on LEFT) -->
      <div class="the-list-btn will-change-transform shrink-0 w-max">
        <a
          href="https://wa.me/?text=Hi%20Crate44%2C%20I%20would%20like%20to%20join%20the%20list"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-btn-morph bg-[#F8FE03] text-[#131313] border border-[#F8FE03] rounded-full relative inline-flex items-center justify-center cursor-pointer font-display font-semibold text-[28px] sm:text-[32px] leading-[28px] sm:leading-[32px] uppercase px-[20px] h-[48px] sm:h-[52px] active:scale-95 flex-shrink-0 transition-[background-color,filter] duration-300 hover:brightness-110 will-change-[border-radius]"
        >
          <span
            class="roll-fx-container relative block h-[32px] leading-[32px] overflow-hidden select-none"
            style="-webkit-mask-image: linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0%, black 18%, black 82%, transparent 100%);"
          >
            <span class="roll-text-top block h-[32px] leading-[32px] whitespace-nowrap will-change-[transform,filter]">
              JOIN THE LIST
            </span>
            <span class="roll-text-bottom absolute inset-0 flex items-center justify-center h-[32px] leading-[32px] whitespace-nowrap will-change-[transform,filter]">
              JOIN THE LIST
            </span>
          </span>
        </a>
      </div>
    </div>

  </div>

  <!-- LAYER B: Masked Flashlight Reveal State (Desktop only >= 1024px: hidden on mobile) -->
  <div
    aria-hidden="true"
    class="the-list-hover-layer hidden lg:flex absolute inset-0 z-20 pointer-events-none items-center py-[56px] lg:py-[64px]"
    style="-webkit-mask-image: radial-gradient(circle 350px at var(--x) var(--y), black 0%, black 50%, rgba(0,0,0,0.5) 75%, transparent 100%); mask-image: radial-gradient(circle 350px at var(--x) var(--y), black 0%, black 50%, rgba(0,0,0,0.5) 75%, transparent 100%);"
  >
    <div class="px-4 lg:px-8 w-full relative z-20 h-full flex items-center">
      <div class="w-full mx-auto h-full flex flex-row items-end justify-between gap-8">
        <div class="flex flex-col items-start w-auto">
          <div class="top-text-block w-full will-change-transform z-10">
            <h2
              class="flex flex-col items-start uppercase text-[clamp(60px,13.88vw,200px)] leading-[0.81] tracking-[0.48px] font-display font-semibold"
            >
              <div class="overflow-hidden pb-1">
                <span
                  class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                  style="background-image: linear-gradient(180deg, #F8FE03 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                  data-line="THE LIST"
                >
                  <span class="the-list-char inline-block">T</span>
                  <span class="the-list-char inline-block">H</span>
                  <span class="the-list-char inline-block">E</span>
                  <span class="the-list-char inline-block">&nbsp;</span>
                  <span class="the-list-char inline-block">L</span>
                  <span class="the-list-char inline-block">I</span>
                  <span class="the-list-char inline-block">S</span>
                  <span class="the-list-char inline-block">T</span>
                </span>
              </div>
            </h2>
          </div>

          <div class="the-list-image-container relative w-full max-w-[474px] my-4 lg:my-11 z-0">
            <div
              class="curve-straight relative w-full aspect-[474/273] overflow-hidden shadow-2xl shrink-0 the-list-image-card will-change-[clip-path]"
              data-curve="straight"
            >
              <img
                src="/images/the-list/the-list-stall-hover.webp"
                alt="Premium Produce"
                class="the-list-image-photo absolute inset-x-0 -top-[8%] w-full h-[116%] object-cover block will-change-transform transition-transform duration-700 ease-out filter brightness-[1.05] saturate-[1.12]"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
              <!-- Golden sunlight gradient highlight for hover flashlight state -->
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-[#F8FE03]/15 via-transparent to-white/10 mix-blend-overlay"
              ></div>
              <!-- Subtle gradient blend overlay to smooth into #131313 -->
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#131313]/35 via-transparent to-[#131313]/20"
              ></div>
              <div class="absolute inset-0 pointer-events-none rounded-[inherit] ring-1 ring-inset ring-white/10"></div>
            </div>
          </div>

          <div class="bottom-text-block w-full will-change-transform z-10">
            <h2
              class="flex flex-col items-start uppercase text-[clamp(60px,13.88vw,200px)] leading-[0.81] tracking-[0.48px] font-display font-semibold"
            >
              <div class="overflow-hidden pb-1">
                <span
                  class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                  style="background-image: linear-gradient(180deg, #F8FE03 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                  data-line="IS SMALL"
                >
                  <span class="the-list-char inline-block">I</span>
                  <span class="the-list-char inline-block">S</span>
                  <span class="the-list-char inline-block">&nbsp;</span>
                  <span class="the-list-char inline-block">S</span>
                  <span class="the-list-char inline-block">M</span>
                  <span class="the-list-char inline-block">A</span>
                  <span class="the-list-char inline-block">L</span>
                  <span class="the-list-char inline-block">L</span>
                </span>
              </div>
              <div class="overflow-hidden pb-1">
                <span
                  class="the-list-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform"
                  style="background-image: linear-gradient(180deg, #F8FE03 0%, #FFF 134.07%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                  data-line="ON PURPOSE"
                >
                  <span class="the-list-char inline-block">O</span>
                  <span class="the-list-char inline-block">N</span>
                  <span class="the-list-char inline-block">&nbsp;</span>
                  <span class="the-list-char inline-block">P</span>
                  <span class="the-list-char inline-block">U</span>
                  <span class="the-list-char inline-block">R</span>
                  <span class="the-list-char inline-block">P</span>
                  <span class="the-list-char inline-block">O</span>
                  <span class="the-list-char inline-block">S</span>
                  <span class="the-list-char inline-block">E</span>
                </span>
              </div>
