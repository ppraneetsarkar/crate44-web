  <!-- Background Media Wrapper: Hardware accelerated layer for parallax video -->
  <div id="hero-media-wrapper" aria-hidden="true" class="absolute inset-0 pointer-events-none z-0 overflow-hidden transform-gpu will-change-transform">
    <!-- Keep the browser's native video pipeline; the hero is the only eager video. -->
    <video
      id="hero-video"
      src="/videos/hero.mp4"
      autoplay
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      poster="/images/hero-bg.webp"
