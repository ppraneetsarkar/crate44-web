                      <path d="M1.25 12.5V7.5H18.75V12.5H1.25Z" fill="currentColor" />
                    </svg>
                  </div>
                </button>

                <div
                  class="faq-mob-content grid transition-all duration-500 ease-in-out"
                  style="grid-template-rows: 0fr; margin-top: 0px; opacity: 0;"
                >
                  <div class="overflow-hidden flex flex-col gap-4">
                    <div
                      class="text-[32px] md:text-[40px] leading-[32px] md:leading-[40px] tracking-[0.128px] md:tracking-[0.16px]"
                      style='color: #FBF9D6; font-family: "Suisse Intl", sans-serif; font-style: normal; font-weight: 700;'
                    >
                      Join our waitlist or keep an eye on our drops.
                    </div>
                    <div
                      class="text-[32px] md:text-[40px] leading-[32px] md:leading-[40px] tracking-[0.128px] md:tracking-[0.16px]"
                      style='font-family: "Suisse Intl", sans-serif; font-style: normal; font-weight: 700;'
                    >
                      <span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">We</span></span><span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">sell</span></span><span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">exclusively</span></span><span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">through</span></span><span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">our</span></span><span class="relative overflow-hidden inline-block mr-[0.28em] my-[-0.14em] align-top"><span class="answer-word block py-[0.14em] will-change-transform" style="background: linear-gradient(180deg, #FBF9D6 53.05%, #FF76FF 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">website.</span></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap'

  document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------------------
    // 1. Initial Entrance Animation (exact timing & easing from crate44.in)
    // -------------------------------------------------------------------------
    const initTl = gsap.timeline({ delay: 0.15 })
    
    initTl.fromTo(
      '.faq-title-inner',
      { yPercent: 150, opacity: 0, rotate: 0.001 },
      { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: 'cubic-bezier(0.31, 0.75, 0.22, 1)' },
      0
    ).fromTo(
      '.faq-question-inner',
      { yPercent: 150, opacity: 0, rotate: 0.001 },
      { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: 'cubic-bezier(0.31, 0.75, 0.22, 1)', stagger: 0.05 },
      0.1
    )

    // Also animate the initial active desktop answer words
    const initialPane = document.querySelector('.faq-answer-pane[data-answer-index="0"]')
    if (initialPane) {
      const initialWords = initialPane.querySelectorAll('.answer-word')
      initTl.fromTo(
        initialWords,
        { yPercent: 150, opacity: 0, rotate: 0.001 },
        { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: 'cubic-bezier(0.31, 0.75, 0.22, 1)', stagger: 0.015 },
        0.2
      )
    }

    // -------------------------------------------------------------------------
    // 2. Desktop Question Switcher & Scroll Tracking
    // -------------------------------------------------------------------------
    const qElements = document.querySelectorAll<HTMLElement>('.faq-q-desktop')
    const answerPanes = document.querySelectorAll<HTMLElement>('.faq-answer-pane')
    
    let activeScrollIndex = 0
    let hoveredIndex: number | null = null
    let currentRenderedIndex = 0

    function switchAnswer(targetIndex: number) {
      if (targetIndex === currentRenderedIndex && !answerPanes[targetIndex].classList.contains('hidden')) {
        return
      }
      currentRenderedIndex = targetIndex

      // Update question text colors
      qElements.forEach((el, idx) => {
        if (idx === targetIndex) {
          el.style.color = 'var(--Color-Creme, #FBF9D6)'
        } else {
          el.style.color = 'var(--Color-Grey-Dark, #464646)'
        }
      })

      // Hide all panes, show target pane
      answerPanes.forEach((pane) => {
        const pIdx = parseInt(pane.getAttribute('data-answer-index') || '-1', 10)
        if (pIdx === targetIndex) {
          pane.classList.remove('hidden')
          // Animate words in target pane
          const words = pane.querySelectorAll('.answer-word')
          gsap.fromTo(
            words,
            { yPercent: 150, opacity: 0, rotate: 0.001 },
            { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: 'cubic-bezier(0.31, 0.75, 0.22, 1)', stagger: 0.015 }
          )
        } else {
          pane.classList.add('hidden')
        }
      })
    }

    qElements.forEach((el) => {
      const idx = parseInt(el.getAttribute('data-index') || '0', 10)

      el.addEventListener('mouseenter', () => {
        hoveredIndex = idx
        switchAnswer(idx)
      })

      el.addEventListener('mouseleave', () => {
        hoveredIndex = null
        switchAnswer(activeScrollIndex)
      })

      el.addEventListener('click', () => {
        activeScrollIndex = idx
        switchAnswer(idx)
      })
    })

    // Scroll listener matching live site math
    const handleScroll = () => {
      if (window.innerWidth < 1024) return
      if (hoveredIndex !== null) return

      let closestIdx = 0
      let minDistance = Infinity

      qElements.forEach((el, idx) => {
        const rect = el.getBoundingClientRect()
        if (rect.width === 0 && rect.height === 0) return
        const dist = Math.abs(rect.top - 120)
        if (rect.top < 270 && dist < minDistance) {
          minDistance = dist
          closestIdx = idx
        }
      })

      if (closestIdx !== activeScrollIndex) {
        activeScrollIndex = closestIdx
        switchAnswer(activeScrollIndex)
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true })

    // -------------------------------------------------------------------------
    // 3. Mobile Accordion Logic
    // -------------------------------------------------------------------------
    const mobItems = document.querySelectorAll<HTMLElement>('.faq-mob-item')
    let currentOpenMobIdx: number | null = 0 // first item open by default

    mobItems.forEach((item) => {
      const idx = parseInt(item.getAttribute('data-mob-index') || '0', 10)
      const btn = item.querySelector<HTMLButtonElement>('.faq-mob-btn')
      const questionEl = item.querySelector<HTMLElement>('.faq-mob-question')
      const iconWrap = item.querySelector<HTMLElement>('.faq-mob-icon')
      const plusSvg = item.querySelector<SVGElement>('.faq-icon-plus')
      const minusSvg = item.querySelector<SVGElement>('.faq-icon-minus')
      const contentEl = item.querySelector<HTMLElement>('.faq-mob-content')

      btn?.addEventListener('click', () => {
        const isOpen = currentOpenMobIdx === idx

        // Close currently open if different
        if (!isOpen) {
          mobItems.forEach((other) => {
            const oContent = other.querySelector<HTMLElement>('.faq-mob-content')
            const oQuestion = other.querySelector<HTMLElement>('.faq-mob-question')
            const oIcon = other.querySelector<HTMLElement>('.faq-mob-icon')
            const oPlus = other.querySelector<SVGElement>('.faq-icon-plus')
            const oMinus = other.querySelector<SVGElement>('.faq-icon-minus')

            if (oContent) {
              oContent.style.gridTemplateRows = '0fr'
              oContent.style.marginTop = '0px'
              oContent.style.opacity = '0'
            }
            if (oQuestion) oQuestion.style.color = '#464646'
            if (oIcon) oIcon.style.color = '#464646'
            if (oPlus) oPlus.setAttribute('class', 'faq-icon-plus absolute inset-0 transition-all duration-300 ease-in-out rotate-0 opacity-100 scale-100')
            if (oMinus) oMinus.setAttribute('class', 'faq-icon-minus absolute inset-0 transition-all duration-300 ease-in-out -rotate-90 opacity-0 scale-50')
          })

          // Open clicked
          currentOpenMobIdx = idx
          if (contentEl) {
            contentEl.style.gridTemplateRows = '1fr'
            contentEl.style.marginTop = '24px'
            contentEl.style.opacity = '1'
          }
          if (questionEl) questionEl.style.color = '#FBF9D6'
          if (iconWrap) iconWrap.style.color = '#FBF9D6'
          if (plusSvg) plusSvg.setAttribute('class', 'faq-icon-plus absolute inset-0 transition-all duration-300 ease-in-out rotate-90 opacity-0 scale-50')
          if (minusSvg) minusSvg.setAttribute('class', 'faq-icon-minus absolute inset-0 transition-all duration-300 ease-in-out rotate-0 opacity-100 scale-100')
        } else {
          // Toggle close current
          currentOpenMobIdx = null
          if (contentEl) {
            contentEl.style.gridTemplateRows = '0fr'
            contentEl.style.marginTop = '0px'
            contentEl.style.opacity = '0'
          }
          if (questionEl) questionEl.style.color = '#464646'
          if (iconWrap) iconWrap.style.color = '#464646'
          if (plusSvg) plusSvg.setAttribute('class', 'faq-icon-plus absolute inset-0 transition-all duration-300 ease-in-out rotate-0 opacity-100 scale-100')
          if (minusSvg) minusSvg.setAttribute('class', 'faq-icon-minus absolute inset-0 transition-all duration-300 ease-in-out -rotate-90 opacity-0 scale-50')
        }
      })
    })
  })
</script>
