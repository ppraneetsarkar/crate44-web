<!-- ──────────────────────────────────────────────────────────── -->
<!-- CLIENT SCRIPT: GSAP ScrollTrigger, Parallax & Flashlight     -->
<!-- ──────────────────────────────────────────────────────────── -->
<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  function initFooterAndList() {
    let luxuryEase: gsap.EaseFunction
    try {
      luxuryEase = CustomEase.create('luxuryFooterRipple', '0.16, 1, 0.3, 1')
    } catch (e) {
      luxuryEase = gsap.parseEase('power3.out')
    }

    // -----------------------------------------------------------
    // 1. THE LIST SECTION (#the-list)
    // -----------------------------------------------------------
    const theList = document.getElementById('the-list')
    if (theList) {
      const revealLines = Array.from(theList.querySelectorAll<HTMLElement>('.the-list-reveal-line'))
        .filter((line) => line.getClientRects().length > 0)
      const chars = revealLines.flatMap((line) => Array.from(line.querySelectorAll<HTMLElement>('.the-list-char')))
      // Mobile uses pure squircle geometry without the rectangular inset clip-path override
      const imageCards = theList.querySelectorAll<HTMLElement>('.the-list-image-card')
      const imagePhotos = theList.querySelectorAll<HTMLElement>('.the-list-image-photo, .the-list-image-photo-mob')
      const paras = theList.querySelectorAll<HTMLElement>('.the-list-para')
      const btns = theList.querySelectorAll<HTMLElement>('.the-list-btn')
      const imgCols = theList.querySelectorAll<HTMLElement>('.the-list-image-container, .the-list-image-col-mobile')
      const bottomRows = theList.querySelectorAll<HTMLElement>('.the-list-bottom-col-mobile')

      // Effect 121: MadeWithGSAP Aperture shutter + inner parallax on The List image cards
      if (imageCards.length > 0 && imagePhotos.length > 0) {
        const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0
        const cardTl = gsap.timeline({
          scrollTrigger: {
            trigger: theList,
            start: 'top bottom',
            end: 'bottom top',
            scrub: isTouchDevice ? 0.4 : 0.6,
          },
        })

        const clipObj = { y: 10 }
        cardTl.fromTo(
          clipObj,
          { y: 10 },
          {
            y: 0,
            ease: 'none',
            duration: 3,
            onUpdate: () => {
              imageCards.forEach((c) => {
                c.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
              })
            },
          }
        )
        .to(clipObj, {
          y: 0,
          ease: 'none',
          duration: 4,
          onUpdate: () => {
            imageCards.forEach((c) => {
              c.style.clipPath = 'inset(0% 0px round 14px)'
            })
          },
        })
        .to(clipObj, {
          y: 10,
          ease: 'none',
          duration: 3,
          onUpdate: () => {
            imageCards.forEach((c) => {
              c.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
            })
          },
        })

        imagePhotos.forEach((photo) => {
          cardTl.fromTo(
            photo,
            { yPercent: -6 },
            { yPercent: 6, ease: 'none', duration: 10 },
            0
          )
        })
      }

      // Mode 1 (Portrait) uses static copy. Avoid starting the reveal offscreen,
      // where the section's overflow boundary can crop the heading during entry.
      if (window.matchMedia('(max-width: 1023px), (orientation: portrait) and (max-width: 1100px)').matches || document.documentElement.hasAttribute('data-mobile-static-copy')) {
        gsap.set(chars, { clearProps: 'transform,opacity,filter' })
        gsap.set(imgCols, { clearProps: 'transform,opacity' })
        gsap.set(bottomRows, { clearProps: 'transform,opacity' })
      } else {
        // Desktop scroll reveal matching Section 1 Standard
        gsap.set(chars, {
          yPercent: 115,
          opacity: 0,
          filter: 'blur(5px)',
        })

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: theList,
            start: 'top 75%',
            toggleActions: 'play none none none',
            once: true,
          },
        })

        const uniqueLines = Array.from(new Set(revealLines.map((line) => line.getAttribute('data-line'))))
        uniqueLines.forEach((lineKey, lineIndex) => {
          const matchingLines = revealLines.filter((line) => line.getAttribute('data-line') === lineKey)
          matchingLines.forEach(line => {
            const lineChars = Array.from(line.querySelectorAll<HTMLElement>('.the-list-char'))
            const lineStartDelay = lineIndex * 0.095

            tl.to(
              lineChars,
              {
                yPercent: 0,
                opacity: 1,
                filter: 'blur(0px)',
                duration: 1.6,
                ease: luxuryEase,
                stagger: { each: 0.024, from: 'center' },
              },
              lineStartDelay
            )
          })
        })

        if (paras.length > 0) {
          tl.fromTo(paras, { y: '40px', opacity: 0 }, { y: '0px', opacity: 1, ease: 'power2.out', duration: 1 }, 0.44)
        }
        if (btns.length > 0) {
          tl.fromTo(btns, { y: '60px', opacity: 0.1 }, { y: '0px', opacity: 1, ease: 'power2.out', duration: 1 }, 0.66)
        }
      }

      // Flashlight cursor tracking effect (Desktop only >= 1024px)
      theList.addEventListener('mousemove', (e) => {
        if (window.innerWidth < 1024) return
        const rect = theList.getBoundingClientRect()
        const x = e.clientX - rect.left
        const y = e.clientY - rect.top
        gsap.to(theList, { '--x': `${x}px`, '--y': `${y}px`, duration: 0.25, ease: 'power2.out', overwrite: 'auto' })
      })
    }

    // -----------------------------------------------------------
    // 2. FOOTER SECTION (<footer>)
    // -----------------------------------------------------------
    const footer = document.querySelector('footer')
    if (footer) {
      const isDesktop = window.innerWidth >= 768

      // Fruit Parallax Card background image scrub
      footer.querySelectorAll<HTMLElement>('.footer-parallax-card').forEach((card) => {
        if (card.offsetParent === null) return
        const bg = card.querySelector<HTMLElement>('.footer-parallax-bg')
        if (bg) {
          gsap.fromTo(
            bg,
            { yPercent: -8 },
            {
              yPercent: 8,
              ease: 'none',
              scrollTrigger: {
                trigger: card,
                start: 'top bottom',
                end: 'bottom top',
                scrub: ScrollTrigger.isTouch ? true : 0.6,
              },
            }
          )
        }

        const lines = card.querySelectorAll<HTMLElement>('.footer-fruit-reveal-line')
        const chars = card.querySelectorAll<HTMLElement>('.footer-fruit-char')
        const btn = card.querySelector<HTMLElement>('.footer-fruit-btn')
        const sub = card.querySelector<HTMLElement>('.footer-fruit-subheading')

        // Initial state matching Section 1 Standard
        gsap.set(chars, {
          yPercent: 115,
          opacity: 0,
          filter: 'blur(5px)',
        })
        if (btn) gsap.set(btn, { opacity: 0, y: 25 })
        if (sub) gsap.set(sub, { opacity: 0, y: 15 })

        const fruitTl = gsap.timeline({
          scrollTrigger: {
            trigger: card,
            start: 'top 80%',
            once: true,
          },
        })

        lines.forEach((line, lineIndex) => {
          const lineChars = Array.from(line.querySelectorAll<HTMLElement>('.footer-fruit-char'))
          const centerIdx = (lineChars.length - 1) / 2
          const lineStartDelay = lineIndex * 0.095

          lineChars.forEach((char, charIdx) => {
            const distFromCenter = Math.abs(charIdx - centerIdx)
            const waveDelay = lineStartDelay + (distFromCenter * 0.024)

            fruitTl.to(
              char,
              {
                yPercent: 0,
                opacity: 1,
                filter: 'blur(0px)',
                duration: 1.6,
                ease: luxuryEase,
              },
              waveDelay
            )
          })
        })

        if (btn) {
          fruitTl.to(btn, { y: 0, opacity: 1, duration: 1.2, ease: luxuryEase }, 0.4)
        }
        if (sub) {
          fruitTl.to(sub, { y: 0, opacity: 1, duration: 1.2, ease: luxuryEase }, 0.5)
        }
      })

      // Massive CRATE44 Title scaleY reveal
      const crateTitles = footer.querySelectorAll<HTMLElement>('.footer-crate-title')
      const titleWrappers = footer.querySelectorAll<HTMLElement>('.footer-crate-title-wrap')

      titleWrappers.forEach((wrapper, idx) => {
        const title = crateTitles[idx]
        if (!title || wrapper.offsetParent === null) return

        const origin = isDesktop ? 'top center' : 'top left'
        gsap.fromTo(
          title,
          { scaleY: 0.05, opacity: 0.2, transformOrigin: origin },
          {
            scaleY: 1,
            opacity: 1,
            ease: 'none',
            transformOrigin: origin,
            scrollTrigger: {
              trigger: wrapper,
              start: 'top 95%',
              end: 'center 65%',
              scrub: ScrollTrigger.isTouch ? true : 0.5,
            },
          }
        )
      })

      // Footer link entrance reveals
      footer.querySelectorAll<HTMLElement>('.footer-roll-link').forEach((el) => {
        if (el.offsetParent === null) return
        if (el.getBoundingClientRect().top > window.innerHeight) {
          gsap.from(el, {
            y: 30,
            opacity: 0,
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 95%',
              toggleActions: 'play none none none',
              once: true,
            },
          })
        }
      })
    }

    // GSAP Feathered Motion-Blur Rolling Text FX for Footer Links
    document.querySelectorAll<HTMLElement>('.footer-roll-link').forEach((link) => {
      const top = link.querySelector<HTMLElement>('.footer-roll-top')
      const bottom = link.querySelector<HTMLElement>('.footer-roll-bottom')
      if (!top || !bottom) return

      gsap.set(top, { yPercent: 0, filter: 'blur(0px)' })
      gsap.set(bottom, { yPercent: 100, filter: 'blur(3.5px)' })

      link.addEventListener('mouseenter', () => {
        gsap.to(top, {
          yPercent: -100,
          filter: 'blur(3.5px)',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })
        gsap.to(bottom, {
          yPercent: 0,
          filter: 'blur(0px)',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })
      })

      link.addEventListener('mouseleave', () => {
        gsap.to(top, {
          yPercent: 0,
          filter: 'blur(0px)',
          duration: 0.35,
          ease: 'power3.out',
          overwrite: 'auto',
        })
        gsap.to(bottom, {
          yPercent: 100,
          filter: 'blur(3.5px)',
          duration: 0.35,
          ease: 'power3.out',
          overwrite: 'auto',
        })
      })
    })

    // GSAP Corner-Morphing & Rolling Text FX for Footer Solo Buttons
    document.querySelectorAll<HTMLElement>('.footer-btn-morph').forEach((btn) => {
      const textTop = btn.querySelector<HTMLElement>('.roll-text-top')
      const textBottom = btn.querySelector<HTMLElement>('.roll-text-bottom')

      gsap.set(btn, {
        borderTopLeftRadius: '28px',
        borderBottomLeftRadius: '28px',
        borderTopRightRadius: '28px',
        borderBottomRightRadius: '28px',
      })

      if (textTop && textBottom) {
        gsap.set(textTop, { yPercent: 0, filter: 'blur(0px)' })
        gsap.set(textBottom, { yPercent: 100, filter: 'blur(3.5px)' })
      }

      btn.addEventListener('mouseenter', () => {
        // Solo button -> Morphs on LEFT (14px 28px 28px 14px)
        gsap.to(btn, {
          borderTopLeftRadius: '14px',
          borderBottomLeftRadius: '14px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.45,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        }
      })

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '28px',
          borderBottomLeftRadius: '28px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        }
      })

      btn.addEventListener('touchstart', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '14px',
          borderBottomLeftRadius: '14px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.45,
          ease: 'power3.out',
          overwrite: 'auto',
        })
        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        }
      }, { passive: true })

      btn.addEventListener('touchend', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '28px',
          borderBottomLeftRadius: '28px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })
        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        }
      }, { passive: true })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterAndList)
  } else {
    initFooterAndList()
  }
</script>
