---
// Crate44 Stamp Logo
interface Props {
  class?: string;
}
const { class: className = "w-[56px] h-[56px] lg:w-[106px] lg:h-[106px]" } = Astro.props;
---
<div class={className}>
  <img
    src="/images/logo/crate44-marquee-stamp.svg"
    alt=""
    aria-hidden="true"
    class="w-full h-full"
  />
</div>
