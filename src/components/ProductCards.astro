                    fruit.inStock
                      ? `https://wa.me/?text=Hi%20Crate44%2C%20I%20would%20like%20to%20order%20${encodeURIComponent(fruit.titleLine1 + ' ' + fruit.titleLine2)}`
                      : '#'
                  }
                  target={fruit.inStock ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class={`card-order-btn product-btn-morph relative inline-flex items-center justify-center font-display font-semibold text-[26px] sm:text-[30px] lg:text-[32px] leading-[34px] uppercase px-5 py-1.5 border transition-[background-color,filter] duration-300 will-change-[border-radius] ${fruit.inStock ? 'bg-[#F8FE03] text-[#131313] border-[#F8FE03] hover:brightness-105 active:scale-95' : 'bg-[#FBF9D6] text-[#5B0000] border-[#FBF9D6] cursor-not-allowed opacity-95'}`}
                  data-node-id={fruit.inStock ? '1861:2846' : '1861:2849'}
                >
