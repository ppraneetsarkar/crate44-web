<!-- Dynamic Font Scaling Rules for Hero matching Page 1 -->
<style>
  .text-fluid-hero {
    font-size: clamp(56px, 18vw, 92px);
    line-height: 0.81em;
  }
  @media (min-width: 951px) {
    .text-fluid-hero {
      font-size: clamp(120px, 12vw, 240px);
      line-height: 0.81em;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initCircularInteraction() {
    const stage = document.getElementById('wheel-stage-container')
    const pivot = document.getElementById('wheel-pivot')
    const slots = document.querySelectorAll('.wheel-card-slot')
    if (!stage || !pivot || slots.length === 0) return

    const totalSlots = slots.length
    const anglePerSlot = 360 / totalSlots

    function getRadius() {
      const width = window.innerWidth
      if (width < 640) return 260
      if (width < 1024) return 380
      return 490
    }

    let radius = getRadius()

    function positionSlots() {
      radius = getRadius()
      slots.forEach((slot, i) => {
        const phi = i * anglePerSlot
        ;(slot as HTMLElement).style.transform = `rotateY(${phi}deg) translateZ(${radius}px)`
      })
    }

    positionSlots()
    window.addEventListener('resize', positionSlots)

    // Motion State
    let currentRotationY = 0
    let targetRotationY = 0
    let currentTiltX = -5
    let targetTiltX = -5
    let currentTiltY = 0
    let targetTiltY = 0
    let isDragging = false
    let startX = 0
    let dragVelocity = 0

    // Spin speed aligned with page scroll speed
    let lastScrollY = window.scrollY
    let scrollVelocity = 0

    window.addEventListener('scroll', () => {
      const delta = window.scrollY - lastScrollY
      lastScrollY = window.scrollY
      scrollVelocity = delta * 0.15
      targetRotationY -= scrollVelocity
    }, { passive: true })

    // Cursor 3D Pivot (Effect 106)
    window.addEventListener('pointermove', (e) => {
      if (isDragging) return
      const rect = stage.getBoundingClientRect()
      const centerX = rect.left + rect.width / 2
      const centerY = rect.top + rect.height / 2

      const normX = (e.clientX - centerX) / (rect.width / 2)
      const normY = (e.clientY - centerY) / (rect.height / 2)

      targetTiltY = gsap.utils.clamp(-14, 14, normX * 12)
      targetTiltX = gsap.utils.clamp(-18, 10, -normY * 10 - 5)
    })

    // Drag / Touch Horizontal Spin
    stage.addEventListener('pointerdown', (e) => {
      isDragging = true
      startX = e.clientX
      stage.style.cursor = 'grabbing'
    })

    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return
      const dx = e.clientX - startX
      startX = e.clientX
      dragVelocity = dx * 0.4
      targetRotationY += dragVelocity
    })

    window.addEventListener('pointerup', () => {
      isDragging = false
      stage.style.cursor = 'grab'
    })

    // Animation Loop with smooth Lerp & Idle Spin
    function updateLoop() {
      if (!isDragging && Math.abs(scrollVelocity) < 0.2) {
        targetRotationY -= 0.12
      }

      currentRotationY += (targetRotationY - currentRotationY) * 0.08
      currentTiltX += (targetTiltX - currentTiltX) * 0.08
      currentTiltY += (targetTiltY - currentTiltY) * 0.08

      scrollVelocity *= 0.9

      pivot.style.transform = `rotateX(${currentTiltX.toFixed(2)}deg) rotateY(${(currentRotationY + currentTiltY).toFixed(2)}deg)`

      requestAnimationFrame(updateLoop)
    }

    updateLoop()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCircularInteraction)
  } else {
    initCircularInteraction()
  }
</script>
