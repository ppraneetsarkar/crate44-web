<!-- True Dynamic Fluid Typography for Section 2 -->
<style>
  .text-gradient-s2 {
    background: linear-gradient(180deg, #f8fe03 0%, #e1ddec 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Mobile: scales fluidly with viewport, exact 80.5px line-height at 95.55px font size (80.5/95.55 ratio = ~0.8425em) auto-scaling */
  .text-fluid-s2-mob {
    font-size: clamp(64px, 24.5vw, 100px);
    line-height: calc(80.5 / 95.55);
  }

  /* Desktop (≥1280px): scales directly with screen width (13.89vw) */
  /* 1280px screen -> 178px */
  /* 1440px screen -> 200px (Figma exact) */
  /* 1920px screen -> 266px */
  /* 2560px screen -> 355px */
  @media (min-width: 951px) {
    .text-fluid-s2-desk {
      font-size: clamp(160px, 13.89vw, 360px);
      line-height: 0.81em;
    }
  }
</style>

<!-- Scripts: Exact Same Smooth Animation as Section 1, Triggered on Headline in View -->
<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  let luxuryEase: gsap.EaseFunction
  try {
    luxuryEase = CustomEase.create('luxuryS2FluidPro', '0.16, 1, 0.3, 1')
  } catch (e) {
    luxuryEase = gsap.parseEase('power3.out')
  }

  function setupScrollTrigger() {
    const isMobile = window.innerWidth < 950
    const activeHeadline = isMobile 
      ? document.querySelector('.s2-headline-mob') 
      : document.querySelector('.s2-headline-desk')

    if (!activeHeadline) return

    const lines = activeHeadline.querySelectorAll<HTMLElement>('.s2-roll-line')
    const s2Copy = document.getElementById('s2-copy')
    const s2ImageCard = document.getElementById('s2-image-card')
    const s2Image = document.getElementById('s2-image')

    const easeLuxury = 'cubic-bezier(0.31, 0.75, 0.22, 1)'

    gsap.set(lines, {
      yPercent: 140,
      opacity: 0,
      rotate: 0.001,
    })

    if (s2Copy) {
      gsap.set(s2Copy, { opacity: 0, y: 30 })
    }

    if (s2ImageCard) {
      gsap.set(s2ImageCard, { opacity: 0, y: 40 })
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: activeHeadline,
        start: 'top 70%',
        once: true,
      },
    })

    tl.to(lines, {
      yPercent: 0,
      opacity: 1,
      rotate: 0,
      duration: 1.1,
      ease: easeLuxury,
      stagger: 0.0825,
    }, 0)

    if (s2ImageCard) {
      tl.to(s2ImageCard, {
        opacity: 1,
        y: 0,
        duration: 1.1,
        ease: easeLuxury,
      }, 0.2)
    }

    if (s2Copy) {
      tl.to(s2Copy, {
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: easeLuxury,
      }, 0.3)
    }

    if (s2ImageCard && s2Image) {
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0
      const isMobile = window.matchMedia('(max-width: 639px)').matches
      const cardTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#section-2',
          start: 'top bottom',
          end: 'bottom top',
          scrub: isTouchDevice ? 0.4 : 0.6,
        },
      })

      if (!isMobile) {
        // Effect 121: Aperture clip-path shutter on desktop image card
        const clipObj = { y: 10 }
        cardTl.fromTo(
          clipObj,
          { y: 10 },
          {
            y: 0,
            ease: 'none',
            duration: 3,
            onUpdate: () => {
              s2ImageCard.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
            },
          }
        )
        .to(clipObj, {
          y: 0,
          ease: 'none',
          duration: 4,
          onUpdate: () => {
            s2ImageCard.style.clipPath = 'inset(0% 0px round 14px)'
          },
        })
        .to(clipObj, {
          y: 10,
          ease: 'none',
          duration: 3,
          onUpdate: () => {
            s2ImageCard.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
          },
        })
      }

      // Smooth vertical counter-parallax on inner image
      cardTl.fromTo(
        s2Image,
        { yPercent: -6 },
        { yPercent: 6, ease: 'none', duration: 10 },
        0
      )
    }
  }

  setTimeout(() => {
    setupScrollTrigger()
    ScrollTrigger.refresh()
  }, 150)

  let lastTriggerWidth = window.innerWidth
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastTriggerWidth) return
    lastTriggerWidth = window.innerWidth
    ScrollTrigger.refresh()
  }, { passive: true })
</script>
