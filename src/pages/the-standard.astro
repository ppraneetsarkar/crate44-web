  }

  .the-promise-headline {
    font-family: 'VVDS_Fifties', 'VVDS Fifties', sans-serif;
    text-transform: uppercase;
    background: linear-gradient(180deg, #3ed5ff 0%, #fff 134.07%) !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    color: transparent !important;
    font-style: normal;
    font-weight: 600;
    font-size: clamp(68px, 24vw, 92px);
    line-height: clamp(58px, 20vw, 76px);
    letter-spacing: clamp(0.8px, 0.18vw, 2.7px);
  }

  @media (min-width: 768px) {
    .the-promise-headline {
      font-size: clamp(92px, 12vw, 130px);
      line-height: clamp(76px, 10vw, 105px);
    }
  }

  @media (min-width: 1024px) {
    .the-promise-headline {
      font-size: clamp(130px, 13.5vw, 240px);
      line-height: clamp(105px, 11vw, 195px);
    }
  }

  .promise-desc-p {
    font-size: clamp(15px, 1.25vw, 19px) !important;
    line-height: 1.25 !important;
  }

  .promise-flip-btn:hover .flip-inner {
    transform: rotateX(90deg) !important;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { RGBELoader } from 'three/examples/jsm/loaders/RGBELoader.js';

  gsap.registerPlugin(ScrollTrigger);

  function initStandardPage() {
    const easeLuxury = "cubic-bezier(0.31, 0.75, 0.22, 1)";

    // ─── Section 0: Hero ─────────────────────────────────────
    const heroSection = document.querySelector(".hero-section-std");
    if (heroSection) {
      gsap.timeline({ delay: 0.15 })
        .fromTo(
          heroSection.querySelectorAll(".hero-line-inner"),
          { yPercent: 150, opacity: 0, rotate: 0.001 },
          { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: easeLuxury, stagger: 0.0825 },
          0
        )
        .fromTo(
          heroSection.querySelectorAll(".hero-sub-line-inner"),
          { yPercent: 150, opacity: 0, rotate: 0.001 },
          { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: easeLuxury },
          0.2
        )
        .fromTo(
          heroSection.querySelectorAll(".hero-fruit-img"),
          { opacity: 0, y: 100, scale: 0.94 },
          { opacity: 1, y: 0, scale: 1, duration: 1, ease: easeLuxury },
          0.1
        );

      initStandardDragonfruit();
    }

    // ─── Section 1: The Four Tests ───────────────────────────
    const testsSection = document.querySelector(".tests-section-std");
    if (testsSection) {
      gsap.fromTo(
        testsSection.querySelectorAll(".tests-headline-line"),
        { y: 150, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.75,
          stagger: 0.07,
          ease: "cubic-bezier(0.83, 0, 0.17, 1)",
          scrollTrigger: {
            trigger: testsSection,
            start: "top 80%",
            toggleActions: "play none none none",
            once: true,
          },
        }
      );

      gsap.fromTo(
        testsSection.querySelectorAll(".tests-placeholder-box"),
        { opacity: 0, y: 60, scale: 0.96 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.9,
          ease: "power2.out",
          scrollTrigger: {
            trigger: testsSection,
            start: "top 75%",
            toggleActions: "play none none none",
            once: true,
          },
        }
      );

      const testsImg = testsSection.querySelector(".the-tests-img");
      if (testsImg) {
        gsap.fromTo(
          testsImg,
          { yPercent: -6 },
          {
            yPercent: 6,
            ease: "none",
            scrollTrigger: {
              trigger: testsSection,
              start: "top bottom",
              end: "bottom top",
              scrub: 0.6,
            },
          }
        );
      }

      testsSection.querySelectorAll(".test-item-card").forEach((card) => {
        const letters = card.querySelectorAll(".effect058-letter");
        gsap.fromTo(
          letters,
          { rotate: -80, opacity: 0 },
          {
            rotate: 0,
            opacity: 1,
            duration: 0.45,
            stagger: 0.008,
            ease: "back.out(1.1)",
            scrollTrigger: {
              trigger: card,
              start: "top 85%",
              toggleActions: "play none none none",
              once: true,
            },
          }
        );
      });
    }

    // ─── Section 2: Chain Comparison ─────────────────────────
    const chainSection = document.querySelector(".mwg_effect022");
    if (chainSection) {
      const theirContainer = chainSection.querySelector(".their-chain-container");
      const ourContainer = chainSection.querySelector(".our-chain-container");

      const updateSegments = () => {
        if (theirContainer) {
          const items = theirContainer.querySelectorAll(".their-chain-item");
          for (let i = 0; i < items.length - 1; i++) {
            const topBadge = items[i]?.querySelector(".chain-badge");
            const botBadge = items[i + 1]?.querySelector(".chain-badge");
            const seg = theirContainer.querySelector(`.their-segment-${i}`);
            if (topBadge && botBadge && seg) {
              const topItem = items[i];
              const botItem = items[i + 1];
              const topBadgeBottom = topItem.offsetTop + topBadge.offsetTop + topBadge.offsetHeight;
              const botBadgeTop = botItem.offsetTop + botBadge.offsetTop;
              const height = Math.max(0, botBadgeTop - topBadgeBottom - 2);
              seg.style.top = topBadgeBottom + "px";
              seg.style.height = height + "px";
            }
          }
        }

        if (ourContainer) {
          const items = ourContainer.querySelectorAll(".our-chain-item");
          for (let i = 0; i < items.length - 1; i++) {
            const topBadge = items[i]?.querySelector(".chain-badge");
            const botBadge = items[i + 1]?.querySelector(".chain-badge");
            const seg = ourContainer.querySelector(`.our-segment-${i}`);
            if (topBadge && botBadge && seg) {
              const topItem = items[i];
              const botItem = items[i + 1];
              const topBadgeBottom = topItem.offsetTop + topBadge.offsetTop + topBadge.offsetHeight;
              const botBadgeTop = botItem.offsetTop + botBadge.offsetTop;
              const height = Math.max(0, botBadgeTop - topBadgeBottom - 2);
              seg.style.top = topBadgeBottom + "px";
              seg.style.height = height + "px";
            }
          }
        }
      };

      updateSegments();
      window.addEventListener("resize", updateSegments);
      setTimeout(() => {
        updateSegments();
        ScrollTrigger.refresh();
      }, 200);

      const mm = gsap.matchMedia();
      mm.add("(min-width: 1024px)", () => {
        const theirItems = chainSection.querySelectorAll(".their-chain-item");
        const ourItems = chainSection.querySelectorAll(".our-chain-item");

        // Initial state: Step 1 / Step 0 active, steps 2+ dormant with opaque solid dimming
        theirItems.forEach((item, idx) => {
          const badge = item.querySelector(".chain-badge");
          const title = item.querySelector(".chain-title");
          if (idx === 0) {
            gsap.set(badge, { filter: "brightness(1) saturate(1)", scale: 1 });
            gsap.set(title, { yPercent: 0, opacity: 1 });
          } else {
            gsap.set(badge, { filter: "brightness(0.35) saturate(0.6)", scale: 0.94 });
            gsap.set(title, { yPercent: 120, opacity: 0 });
          }
        });

        ourItems.forEach((item, idx) => {
          const badge = item.querySelector(".chain-badge");
          const title = item.querySelector(".chain-title");
          if (idx === 0) {
            gsap.set(badge, { filter: "brightness(1) saturate(1)", scale: 1 });
            gsap.set(title, { yPercent: 0, opacity: 1 });
          } else {
            gsap.set(badge, { filter: "brightness(0.35) saturate(0.6)", scale: 0.94 });
            gsap.set(title, { yPercent: 120, opacity: 0 });
          }
        });

        // Initialize all line segments at 0 height
        for (let i = 0; i < 5; i++) {
          gsap.set(`.their-segment-${i}`, { scaleY: 0, transformOrigin: "top center" });
        }
        for (let i = 0; i < 3; i++) {
          gsap.set(`.our-segment-${i}`, { scaleY: 0, transformOrigin: "top center" });
        }

        // Natural unpinned scroll flow (desktop): flows seamlessly with steps without sticking
        const pinTl = gsap.timeline({
          scrollTrigger: {
            trigger: chainSection,
            start: "top 60%",
            end: "bottom 75%",
            scrub: 0.7,
            invalidateOnRefresh: true,
          },
        });

        // 1. Their Chain: 5 segments connecting 6 steps
        for (let i = 0; i < 5; i++) {
          const segStart = i * 2.0;
          const segDuration = 1.8;
          const touchTime = segStart + segDuration;
          const nextBadge = theirItems[i + 1]?.querySelector(".chain-badge");
          const nextTitle = theirItems[i + 1]?.querySelector(".chain-title");

          // Draw line from bottom of current badge to top of next badge
          pinTl.to(`.their-segment-${i}`, { scaleY: 1, ease: "none", duration: segDuration }, segStart);

          // On touch: illuminate next badge and reveal text
          if (nextBadge) {
            pinTl.to(nextBadge, {
              filter: "brightness(1) saturate(1)",
              scale: 1.15,
              borderColor: "#FBF9D6",
              boxShadow: "0 0 20px rgba(251, 249, 214, 0.5)",
              duration: 0.35,
              ease: "power2.out",
            }, touchTime);
            pinTl.to(nextBadge, {
              scale: 1,
              boxShadow: "0 0 0px rgba(251, 249, 214, 0)",
              duration: 0.35,
              ease: "power2.in",
            }, touchTime + 0.35);
          }
          if (nextTitle) {
            pinTl.to(nextTitle, {
              yPercent: 0,
              opacity: 1,
              duration: 0.8,
              ease: easeLuxury,
            }, touchTime);
          }
        }

        // 2. Our Chain: 3 segments connecting 4 steps
        const ourStepDuration = 3.0;
        const ourStepInterval = 10.0 / 3;
        for (let i = 0; i < 3; i++) {
          const segStart = i * ourStepInterval;
          const touchTime = segStart + ourStepDuration;
          const nextBadge = ourItems[i + 1]?.querySelector(".chain-badge");
          const nextTitle = ourItems[i + 1]?.querySelector(".chain-title");

          // Draw line from bottom of current badge to top of next badge
          pinTl.to(`.our-segment-${i}`, { scaleY: 1, ease: "none", duration: ourStepDuration }, segStart);

          // On touch: illuminate next badge with neon gold glow and reveal text
          if (nextBadge) {
            pinTl.to(nextBadge, {
              filter: "brightness(1) saturate(1)",
              scale: 1.18,
              boxShadow: "0 0 24px rgba(248, 254, 3, 0.8)",
              duration: 0.35,
              ease: "back.out(1.5)",
            }, touchTime);
            pinTl.to(nextBadge, {
              scale: 1,
              boxShadow: "0 0 8px rgba(248, 254, 3, 0.3)",
              duration: 0.35,
              ease: "power2.in",
            }, touchTime + 0.35);
          }
          if (nextTitle) {
            pinTl.to(nextTitle, {
              yPercent: 0,
              opacity: 1,
              duration: 0.8,
              ease: easeLuxury,
            }, touchTime);
          }
        }
      });

      mm.add("(max-width: 1023px)", () => {
        // Mobile scrubbed sequence per container with segment isolation
        const setupMobileChain = (containerSelector, segmentPrefix, itemSelector, count) => {
          const container = chainSection.querySelector(containerSelector);
          if (!container) return;

          const items = container.querySelectorAll(itemSelector);
          items.forEach((item, idx) => {
            const badge = item.querySelector(".chain-badge");
            const title = item.querySelector(".chain-title");
            if (idx === 0) {
              gsap.set(badge, { filter: "brightness(1) saturate(1)", scale: 1 });
              gsap.set(title, { yPercent: 0, opacity: 1 });
            } else {
              gsap.set(badge, { filter: "brightness(0.35) saturate(0.6)", scale: 0.94 });
              gsap.set(title, { yPercent: 120, opacity: 0 });
            }
          });

          const segCount = count - 1;
          for (let i = 0; i < segCount; i++) {
            gsap.set(`.${segmentPrefix}-${i}`, { scaleY: 0, transformOrigin: "top center" });
          }

          const mobTl = gsap.timeline({
            scrollTrigger: {
              trigger: container,
              start: "top 65%",
              end: "bottom 75%",
              scrub: 0.6,
            },
          });

          const stepInterval = 10 / segCount;
          const drawDuration = stepInterval * 0.85;

          for (let i = 0; i < segCount; i++) {
            const segStart = i * stepInterval;
            const touchTime = segStart + drawDuration;
            const nextBadge = items[i + 1]?.querySelector(".chain-badge");
            const nextTitle = items[i + 1]?.querySelector(".chain-title");

            mobTl.to(`.${segmentPrefix}-${i}`, { scaleY: 1, ease: "none", duration: drawDuration }, segStart);

            if (nextBadge) {
              mobTl.to(nextBadge, {
                filter: "brightness(1) saturate(1)",
                scale: 1.12,
                duration: 0.35,
                ease: "power2.out",
              }, touchTime);
              mobTl.to(nextBadge, {
                scale: 1,
                duration: 0.35,
                ease: "power2.in",
              }, touchTime + 0.35);
            }
            if (nextTitle) {
              mobTl.to(nextTitle, {
                yPercent: 0,
                opacity: 1,
                duration: 0.7,
                ease: easeLuxury,
              }, touchTime);
            }
          }
        };

        setupMobileChain(".their-chain-container", "their-segment", ".their-chain-item", 6);
        setupMobileChain(".our-chain-container", "our-segment", ".our-chain-item", 4);
      });
    }

    // ─── Section 3: What happens with rejected fruit ─────────
    const rejectedSection = document.querySelector(".rejected-section-std");
    if (rejectedSection) {
      const isMobile = window.innerWidth < 1024;
      const targetLines = isMobile
        ? rejectedSection.querySelectorAll(".rejected-fruit-content-mob .rejected-fruit-line-inner")
        : rejectedSection.querySelectorAll(".rejected-fruit-content-desk .rejected-fruit-line-inner");

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: rejectedSection,
          start: "top 75%",
          toggleActions: "play none none none",
          once: true,
        },
      });

      tl.fromTo(
        targetLines,
        { yPercent: 120, opacity: 0, rotate: 0.001 },
        { yPercent: 0, opacity: 1, rotate: 0, duration: 1.1, ease: easeLuxury, stagger: 0.0825 },
        0
      );

      const rejDesc = rejectedSection.querySelectorAll(".rejected-fruit-desc");
      if (rejDesc.length > 0) {
        tl.fromTo(
          rejDesc,
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, duration: 0.9, ease: easeLuxury },
          0.35
        );
      }

      // Exact Section 3 Home: Effect 121 Aperture Clip-Path Shutter & Counter-Parallax
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
      const imgCard = isMobile
        ? rejectedSection.querySelector(".rejected-fruit-content-mob .rejected-fruit-img-wrap")
        : rejectedSection.querySelector(".rejected-fruit-content-desk .rejected-fruit-img-wrap");
      const imgEl = isMobile
        ? rejectedSection.querySelector(".rejected-fruit-content-mob .rejected-fruit-img")
        : rejectedSection.querySelector(".rejected-fruit-content-desk .rejected-fruit-img");

      if (imgCard && imgEl) {
        const cardTl = gsap.timeline({
          scrollTrigger: {
            trigger: rejectedSection,
            start: "top bottom",
            end: "bottom top",
            scrub: isTouchDevice ? 0.4 : 0.6,
          },
        });

        // Effect 121: Aperture clip-path shutter on image card
        const clipObj = { y: 10 };
        cardTl.fromTo(
          clipObj,
          { y: 10 },
          {
            y: 0,
            ease: "none",
            duration: 3,
            onUpdate: () => {
              imgCard.style.clipPath = "inset(" + clipObj.y.toFixed(2) + "% 0px round 14px)";
            },
          }
        )
        .to(clipObj, {
          y: 0,
          ease: "none",
          duration: 4,
          onUpdate: () => {
            imgCard.style.clipPath = "inset(0% 0px round 14px)";
          },
        })
        .to(clipObj, {
          y: 10,
          ease: "none",
          duration: 3,
          onUpdate: () => {
            imgCard.style.clipPath = "inset(" + clipObj.y.toFixed(2) + "% 0px round 14px)";
          },
        });

        // Smooth vertical counter-parallax on inner image
        cardTl.fromTo(
          imgEl,
          { yPercent: -10 },
          { yPercent: 10, ease: "none", duration: 10 },
          0
        );
      }
    }

    // ─── Section 4: The Promise ──────────────────────────────
    const promiseSection = document.querySelector(".promise-section-std");
    if (promiseSection) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: promiseSection,
          start: "top 80%",
          toggleActions: "play none none none",
          once: true,
        },
      });

      const placeholder = promiseSection.querySelector(".promise-box-placeholder");
      if (placeholder) {
        tl.fromTo(placeholder, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0);
      }

      const headline = promiseSection.querySelector(".the-promise-headline");
      if (headline) {
        tl.fromTo(headline, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" }, 0.15);
      }

      const desc = promiseSection.querySelector(".promise-desc-p");
      if (desc) {
        tl.fromTo(desc, { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 0.3);
      }

      const buttons = promiseSection.querySelector(".promise-btn-wrap");
      if (buttons) {
        tl.fromTo(buttons, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.4);
      }

      // GSAP Corner-Morphing & Rolling Text FX for Standard Paired Buttons
      const btnLeft = promiseSection.querySelector<HTMLElement>(".std-btn-left");
      const btnRight = promiseSection.querySelector<HTMLElement>(".std-btn-right");

      if (btnLeft) {
        const textTop = btnLeft.querySelector<HTMLElement>(".roll-text-top");
        const textBottom = btnLeft.querySelector<HTMLElement>(".roll-text-bottom");

        gsap.set(btnLeft, {
          borderTopLeftRadius: "28px",
          borderBottomLeftRadius: "28px",
          borderTopRightRadius: "28px",
          borderBottomRightRadius: "28px",
        });

        if (textTop && textBottom) {
          gsap.set(textTop, { yPercent: 0, filter: "blur(0px)" });
          gsap.set(textBottom, { yPercent: 100, filter: "blur(3.5px)" });
        }

        btnLeft.addEventListener("mouseenter", () => {
          // Left button in pair -> Morphs on RIGHT (28px 14px 14px 28px)
          gsap.to(btnLeft, {
            borderTopRightRadius: "14px",
            borderBottomRightRadius: "14px",
            borderTopLeftRadius: "28px",
            borderBottomLeftRadius: "28px",
            duration: 0.45,
            ease: "power3.out",
            overwrite: "auto",
          });

          if (textTop && textBottom) {
            gsap.to(textTop, { yPercent: -100, filter: "blur(3.5px)", duration: 0.42, ease: "power3.out", overwrite: "auto" });
            gsap.to(textBottom, { yPercent: 0, filter: "blur(0px)", duration: 0.42, ease: "power3.out", overwrite: "auto" });
          }
        });

        btnLeft.addEventListener("mouseleave", () => {
          gsap.to(btnLeft, {
            borderTopRightRadius: "28px",
            borderBottomRightRadius: "28px",
            borderTopLeftRadius: "28px",
            borderBottomLeftRadius: "28px",
            duration: 0.38,
            ease: "power3.out",
            overwrite: "auto",
          });

          if (textTop && textBottom) {
            gsap.to(textTop, { yPercent: 0, filter: "blur(0px)", duration: 0.38, ease: "power3.out", overwrite: "auto" });
            gsap.to(textBottom, { yPercent: 100, filter: "blur(3.5px)", duration: 0.38, ease: "power3.out", overwrite: "auto" });
          }
        });
      }

      if (btnRight) {
        const textTop = btnRight.querySelector<HTMLElement>(".roll-text-top");
        const textBottom = btnRight.querySelector<HTMLElement>(".roll-text-bottom");

        gsap.set(btnRight, {
          borderTopLeftRadius: "28px",
          borderBottomLeftRadius: "28px",
          borderTopRightRadius: "28px",
          borderBottomRightRadius: "28px",
        });

        if (textTop && textBottom) {
          gsap.set(textTop, { yPercent: 0, filter: "blur(0px)" });
          gsap.set(textBottom, { yPercent: 100, filter: "blur(3.5px)" });
        }

        btnRight.addEventListener("mouseenter", () => {
          // Right button in pair -> Morphs on LEFT (14px 28px 28px 14px)
          gsap.to(btnRight, {
            borderTopLeftRadius: "14px",
            borderBottomLeftRadius: "14px",
            borderTopRightRadius: "28px",
            borderBottomRightRadius: "28px",
            duration: 0.45,
            ease: "power3.out",
            overwrite: "auto",
          });

          if (textTop && textBottom) {
            gsap.to(textTop, { yPercent: -100, filter: "blur(3.5px)", duration: 0.42, ease: "power3.out", overwrite: "auto" });
            gsap.to(textBottom, { yPercent: 0, filter: "blur(0px)", duration: 0.42, ease: "power3.out", overwrite: "auto" });
          }
        });

        btnRight.addEventListener("mouseleave", () => {
          gsap.to(btnRight, {
            borderTopLeftRadius: "28px",
            borderBottomLeftRadius: "28px",
            borderTopRightRadius: "28px",
            borderBottomRightRadius: "28px",
            duration: 0.38,
            ease: "power3.out",
            overwrite: "auto",
          });

          if (textTop && textBottom) {
            gsap.to(textTop, { yPercent: 0, filter: "blur(0px)", duration: 0.38, ease: "power3.out", overwrite: "auto" });
            gsap.to(textBottom, { yPercent: 100, filter: "blur(3.5px)", duration: 0.38, ease: "power3.out", overwrite: "auto" });
          }
        });
      }
    }
  }

  // ─── 3D Dragon Fruit: Native WebGL, Direct Three.js & Scroll Sync ───
  function initStandardDragonfruit() {
    const container = document.getElementById("standard-fruit-container");
    if (!container) return;

    // Clean up any previously attached canvases if re-run
    container.innerHTML = "";

    const width = container.clientWidth || 360;
    const height = container.clientHeight || 360;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    // Camera looking down from Y = 5.3 at (0,0,0) — exact 3D Studio orientation viewing the side profile
    camera.position.set(0, 5.3, 0);
    camera.rotation.set(-Math.PI / 2, 0, -Math.PI);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.76;
    renderer.domElement.style.width = "100%";
    renderer.domElement.style.height = "100%";
    renderer.domElement.style.display = "block";
    renderer.domElement.style.opacity = "0";
    renderer.domElement.style.transition = "opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1)";
    renderer.domElement.style.pointerEvents = "auto";
    container.appendChild(renderer.domElement);

    // Studio Lighting matching exact 3D Studio specifications
    const mainLight = new THREE.DirectionalLight(0xffffff, 1.3);
    mainLight.position.set(5, 8, 5);
    scene.add(mainLight);

    const fillLight = new THREE.DirectionalLight(0xffffff, 0.6);
    fillLight.position.set(-5, -2, -5);
    scene.add(fillLight);

    const ambientLight = new THREE.AmbientLight(0xffe700, 0.8);
    scene.add(ambientLight);

    // PMREM & Broadway Hall HDR
    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    pmremGenerator.compileEquirectangularShader();
    const rgbeLoader = new RGBELoader();
    rgbeLoader.load(
      "/models/dragonfruit/broadway_hall_1k.hdr",
      (texture) => {
        const envMap = pmremGenerator.fromEquirectangular(texture).texture;
        scene.environment = envMap;
        scene.environmentRotation.y = THREE.MathUtils.degToRad(266);
        texture.dispose();
      },
      undefined,
      (err) => console.warn("HDR load notice:", err)
    );

    // Optimized WebP Textures
    const textureLoader = new THREE.TextureLoader();
    const baseColorTex = textureLoader.load("/models/dragonfruit/dragonfruit_baseColor_opt.webp");
    baseColorTex.colorSpace = THREE.SRGBColorSpace;
    baseColorTex.flipY = false;

    const normalTex = textureLoader.load("/models/dragonfruit/dragonfruit_normal_opt.webp");
    normalTex.colorSpace = THREE.NoColorSpace;
    normalTex.flipY = false;

    const roughnessTex = textureLoader.load("/models/dragonfruit/dragonfruit_roughness_opt.webp");
    roughnessTex.colorSpace = THREE.NoColorSpace;
    roughnessTex.flipY = false;

    const metalnessTex = textureLoader.load("/models/dragonfruit/dragonfruit_metalness_opt.webp");
    metalnessTex.colorSpace = THREE.NoColorSpace;
    metalnessTex.flipY = false;

    const material = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      map: baseColorTex,
      normalMap: normalTex,
      normalScale: new THREE.Vector2(0.42, 0.42),
      roughness: 0.71,
      roughnessMap: roughnessTex,
      metalness: 0.08,
      metalnessMap: metalnessTex,
      envMapIntensity: 5.0,
    });

    const outerGroup = new THREE.Group();
    // Layout tilt of 18.813° matching original site
    outerGroup.rotation.z = THREE.MathUtils.degToRad(18.813);

    const innerGroup = new THREE.Group();
    outerGroup.add(innerGroup);
    scene.add(outerGroup);

    // Base Euler angles from 3D studio controls
    const BASE_ROT_X = THREE.MathUtils.degToRad(276.7);
    const BASE_ROT_Y = THREE.MathUtils.degToRad(167.4);
    const BASE_ROT_Z = THREE.MathUtils.degToRad(175.1);

    innerGroup.rotation.set(BASE_ROT_X, BASE_ROT_Y, BASE_ROT_Z);

    const gltfLoader = new GLTFLoader();
    gltfLoader.load("/models/dragonfruit/dragonfruit_opt.glb", (gltf) => {
      const object = gltf.scene;
      object.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          const mesh = child as THREE.Mesh;
          mesh.material = material;
          mesh.castShadow = true;
          mesh.receiveShadow = true;
        }
      });

      const box = new THREE.Box3().setFromObject(object);
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z) || 1;
      // 50% bigger scale (3.6 vs 2.4)
      const scale = 3.6 / maxDim;

      object.scale.setScalar(scale);
      object.position.sub(center.multiplyScalar(scale));
      innerGroup.add(object);

      innerGroup.updateMatrixWorld(true);

      updateLayout();

      // Smooth direct reveal — zero glitch, zero placeholder
      renderer.domElement.style.opacity = "1";
    });

    function updateLayout() {
      const w = container.clientWidth || 360;
      const h = container.clientHeight || 360;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    const ro = new ResizeObserver(updateLayout);
    ro.observe(container);

    // Scroll orchestration & multi-axis floating animation
    let isInView = true;
    let animId = 0;
    let time = 0;
    let scrollRotY = 0;
    let targetScrollRotY = 0;
    let idleRotY = 0;

    const heroSec = document.querySelector(".hero-section-std");
    if (heroSec) {
      ScrollTrigger.create({
        trigger: heroSec,
        start: "top top",
        end: "bottom top",
        scrub: true,
        onUpdate: (self) => {
          targetScrollRotY = self.progress * Math.PI * 4;
        },
      });
    }

    function animate() {
      if (!isInView || document.hidden) {
        animId = 0;
        return;
      }
      animId = requestAnimationFrame(animate);

      time += 0.018;

      // Silky weighted momentum for scroll-driven spins
      scrollRotY += (targetScrollRotY - scrollRotY) * 0.12;

      // Gentle continuous idle spin
      idleRotY += 0.003;

      // Multi-axis floating motion:
      // In this top-down camera projection (looking down from Y=5.3),
      // World Z is the vertical screen axis (UP/DOWN floating bobbing)
      const floatZ = Math.sin(time * 1.6) * 0.12;
      // World X is the horizontal screen axis (subtle buoyant lateral drift)
      const floatX = Math.cos(time * 1.1) * 0.04;
      // World Y is depth breathing
      const floatY = Math.sin(time * 1.3) * 0.03;

      innerGroup.position.set(floatX, floatY, floatZ);

      // Organic tilt sway + idle spin + scroll-driven spins
      innerGroup.rotation.x = BASE_ROT_X + Math.sin(time * 0.9) * 0.045;
      innerGroup.rotation.y = BASE_ROT_Y + idleRotY + scrollRotY;
      innerGroup.rotation.z = BASE_ROT_Z + Math.cos(time * 0.9) * 0.035;

      renderer.render(scene, camera);
    }

    function startAnimate() {
      if (!animId) animId = requestAnimationFrame(animate);
    }

    function stopAnimate() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = 0;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          isInView = e.isIntersecting;
          if (isInView && !document.hidden) startAnimate();
          else stopAnimate();
        });
      },
      { threshold: 0.05 }
    );

    if (heroSec) observer.observe(heroSec);
    startAnimate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStandardPage);
  } else {
    initStandardPage();
  }
  document.addEventListener("astro:page-load", initStandardPage);
</script>
