---
// src/pages/the-standard.astro
// Exact implementation ported directly from https://crate44.in/the-standard
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'
---

<Layout title="The Standard | Crate 44 — Logistics & Grading">
  <main class="min-h-screen w-full overflow-x-clip bg-[#131313] selection:bg-[#F8FE03] selection:text-black">
    <!-- Section 0: Hero -->
<section class="hero-section-std relative w-full h-[100dvh] min-h-[100dvh] flex items-center justify-center overflow-hidden bg-[#131313] border-b border-[#1E1E1E] pt-[90px] sm:pt-[105px] lg:pt-[100px] pb-6 sm:pb-8 lg:pb-12">
 <div class="px-4 lg:px-8 relative z-10 w-full">
  <div class="w-full mx-auto w-full flex flex-col lg:flex-row items-center justify-between gap-2 lg:gap-8 xl:gap-12" style="max-width:none">
   <div class="w-full lg:flex-1 flex flex-col items-center lg:items-start text-center lg:text-left min-w-0">
    <h1 class="hero-headline select-none flex flex-col items-center lg:items-start w-full text-center lg:text-left">
     <span class="block overflow-hidden pb-[0.05em]">
      <span
        class="hero-line-inner block will-change-transform"
        style="background: linear-gradient(180deg, var(--Color-Creme, #FBF9D6) 0%, var(--Color-Fushia, #FC558D) 100%); background-size: 100% 200%; background-position: top; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;"
      >
       MOST
      </span>
     </span>
     <span class="block overflow-hidden pb-[0.05em]">
      <span
        class="hero-line-inner block will-change-transform"
        style="background: linear-gradient(180deg, var(--Color-Creme, #FBF9D6) 0%, var(--Color-Fushia, #FC558D) 100%); background-size: 100% 200%; background-position: bottom; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;"
      >
       FRUIT FAILS.
      </span>
     </span>
    </h1>
    <div class="w-full max-w-[340px] lg:max-w-[500px] mt-2 lg:mt-5 text-[#FC558D] font-body font-semibold text-center lg:text-left text-[14px] leading-[17px] tracking-[-0.4px] lg:text-[16px] lg:leading-[20px]">
     <span class="block overflow-hidden">
      <span class="hero-sub-line-inner block will-change-transform">
       <span class="lg:hidden">
        “What our grading table does to 500 fruits, every morning.”
       </span>
       <span class="hidden lg:inline">
        What our grading table does to 500 fruits, every morning.
       </span>
      </span>
     </span>
    </div>
   </div>
   <div class="w-full lg:w-auto flex-shrink-0 flex items-center justify-center lg:justify-end mt-4 sm:mt-6 lg:mt-0">
    <div class="hero-fruit-img relative w-[clamp(280px,40vh,420px)] max-w-[calc(100vw-32px)] lg:w-[clamp(440px,38vw,880px)] aspect-square flex items-center justify-center will-change-transform select-none">
     <div id="standard-fruit-container" class="w-full h-full relative cursor-grab active:cursor-grabbing pointer-events-auto filter drop-shadow-[0_24px_40px_rgba(0,0,0,0.3)]">
     </div>
    </div>
   </div>
  </div>
 </div>
</section>


    <!-- Section: This Month's Ledger -->
    <section class="ledger-section-std relative w-full bg-[#131313] border-b border-[#1E1E1E] py-14 sm:py-16 lg:py-20 xl:py-24 overflow-hidden">
      <div class="px-4 lg:px-8 relative z-10 w-full">
        <div class="w-full mx-auto flex flex-col gap-10 sm:gap-12 lg:gap-16">
          <!-- Section Title -->
          <h2 class="ledger-title text-[#F8FE03] font-body font-semibold select-none">
            This Month’s Ledger
          </h2>

          <!-- 4 Stats: 2x2 Grid on Desktop, Single Column Stack on Mobile -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-x-12 lg:gap-y-16 w-full">
            <!-- Stat 1: Graded -->
            <div class="flex flex-col gap-2.5 lg:gap-5 items-start">
              <span class="ledger-number select-none">14,206</span>
              <span class="ledger-label text-[#FBF9D6] font-body font-semibold select-none">Graded</span>
            </div>

            <!-- Stat 2: Rejected -->
            <div class="flex flex-col gap-2.5 lg:gap-5 items-start">
              <span class="ledger-number select-none">8,660</span>
              <span class="ledger-label text-[#FBF9D6] font-body font-semibold select-none">Rejected</span>
            </div>

            <!-- Stat 3: Replaced, No Questions Asked -->
            <div class="flex flex-col gap-2.5 lg:gap-5 items-start">
              <span class="ledger-number select-none">11</span>
              <span class="ledger-label text-[#FBF9D6] font-body font-semibold select-none">
                <span class="block">Replaced,</span>
                <span class="block">No Questions Asked</span>
              </span>
            </div>

            <!-- Stat 4: Farms Under Contract -->
            <div class="flex flex-col gap-2.5 lg:gap-5 items-start">
              <span class="ledger-number select-none">5</span>
              <span class="ledger-label text-[#FBF9D6] font-body font-semibold select-none">Farms Under Contract</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Section 1: The Four Tests -->
<section class="tests-section-std relative w-full bg-[#131313] border-b border-[#1E1E1E] py-16 sm:py-20 lg:py-28 text-white overflow-hidden">
