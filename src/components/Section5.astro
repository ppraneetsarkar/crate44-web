---
// src/components/Section5.astro
// Exact Implementation of Section 5 (Proof in numbers) with MadeWithGSAP Effect 037 Vertical Fading Transition
// - Pure white background (#FDFEFF) with hot pink typography (#FC558D)
// - Strict 16px margins matching other sections
// - Kept all typography, stats, headlines, and promise subtext exactly as design
// - Replaced rolling cards with MadeWithGSAP Effect 037: Pinned vertical gradient-mask image fading transition
// - 100% responsive across Mobile (375/390/430), Tablet (768/1024), Desktop (1440/1920), and 4K

const proofItems = [
  {
    number: "60%",
    titleLine1: "Rejected at",
    titleLine2: "our table last week",
    image: "/images/proof/figma_card_1.png",
    alt: "Pineapple grading at table in Mumbai",
  },
  {
    number: "14°Bx",
    titleLine1: "Minimum sweetness",
    titleLine2: "for a mango to pass",
    image: "/images/proof/figma_card_2.png",
    alt: "Alphonso mango peak sweetness grading",
  },
  {
    number: "0",
    titleLine1: "Questions asked",
    titleLine2: "when we replace a piece",
    image: "/images/proof/figma_card_3.png",
    alt: "Fresh pomegranates crate promise",
  },
]
---

<section
  id="section-5"
  class="relative w-full h-[100svh] min-h-[600px] bg-[#FDFEFF] text-[#FC558D] overflow-hidden select-none"
  data-node-id="1873:2052"
>
  <!-- Full-width content wrapper with strict 16px side margin matching other sections -->
  <div class="s5-desktop-layout relative w-full h-full px-[16px] flex flex-col justify-between pt-[32px] sm:pt-[40px] xl:pt-[42px] pb-[20px] sm:pb-[24px] xl:pb-[24px]">
    
    <!-- TOP ROW: Right-Aligned Promise Subtext (Desktop: Suisse Intl 16px / 20px / 600 weight / -0.4px) -->
    <div class="relative w-full flex items-start justify-end z-20 pointer-events-none">
      <p
        class="s5-promise-copy w-full sm:max-w-[360px] xl:max-w-[397px] font-body font-bold xl:font-semibold text-[16px] xl:text-[16px] leading-[20px] xl:leading-[20px] tracking-[-0.16px] xl:tracking-[-0.4px] text-[#FC558D] text-right pointer-events-auto"
        data-node-id="1859:2756"
      >
        Every piece is graded by hand at our table in Mumbai. We measure sugar, pressure, aroma and patience. Most fruit fails. What passes carries the mark and our promise: if a single piece isn’t right, we replace it before you finish telling us
      </p>
    </div>

    <!-- CENTER STAGE: MADE WITH GSAP EFFECT 037 VERTICAL FADING TRANSITION -->
    <div class="s5-stage-overlay absolute inset-0 flex items-center justify-center pointer-events-none z-10">
      <div
        class="s5-vertical-stage curve-straight relative overflow-hidden shadow-2xl pointer-events-auto will-change-transform"
        data-curve="straight"
      >
        {proofItems.map((item, idx) => (
          <div
            class="s5-effect037-slide absolute inset-0 w-full h-full overflow-hidden will-change-[mask-image,-webkit-mask-image]"
            data-index={idx}
            style={idx === 0 ? "z-index: 1;" : `z-index: ${idx + 1};`}
          >
            <img
              src={item.image}
              alt={item.alt}
              class="s5-effect037-img w-full h-full object-cover block will-change-transform"
              loading="eager"
              draggable="false"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- BOTTOM ROW: LEFT-ALIGNED STATS & HEADLINES (Node 1859:2746) -->
    <!-- MadeWithGSAP Effect 037 Vertical Fading Transition applied to Text -->
    <div class="s5-text-row relative w-full flex items-end justify-between z-20 pointer-events-none">
      <div class="s5-loco-text relative pointer-events-auto text-left w-full max-w-[360px] sm:max-w-[500px] lg:max-w-[620px] xl:max-w-[680px] h-[180px] sm:h-[240px] lg:h-[300px] xl:h-[320px] z-30">
        {proofItems.map((item, idx) => (
          <div
            class="s5-text-slide absolute inset-0 flex flex-col justify-end text-left select-none will-change-[mask-image,-webkit-mask-image]"
            data-text-index={idx}
            style={idx === 0 ? "z-index: 1;" : `z-index: ${idx + 1};`}
          >
            <!-- Number (Node 1859:2747) -->
            <div class="flex items-center justify-start select-none">
              <span
                class="font-display font-semibold uppercase text-[95px] sm:text-[145px] xl:text-[200px] leading-[90px] sm:leading-[125px] xl:leading-[162px] tracking-[0.48px] bg-clip-text text-transparent"
                style="background-image: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
              >
                {item.number}
              </span>
            </div>

            <!-- Descriptive Headline (Node 1859:2751) -->
            <div class="flex flex-col justify-center select-none text-left mt-1 sm:mt-2">
              <p class="s5-stat-headline font-semibold text-[#FC558D] m-0 whitespace-nowrap text-left">
                {item.titleLine1}
              </p>
              <p class="s5-stat-headline font-semibold text-[#FC558D] m-0 whitespace-nowrap text-left">
                {item.titleLine2}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Phone reference layout: each proof point flows in order with its image.
       This replaces the pinned, overlapping desktop stage below 500px. -->
  <div class="s5-mobile-layout hidden w-full flex-col gap-6 px-4 py-8">
    <!-- Divider before 60% -->
    <div class="w-full h-[1px] bg-[#E1DDEC] flex-shrink-0" aria-hidden="true"></div>

    {proofItems.map((item) => (
      <>
        <article class="s5-mobile-proof flex w-full flex-col gap-4">
          <div class="flex w-full flex-col items-start text-left">
            <span
              class="font-display font-semibold uppercase text-[clamp(92px,32vw,136px)] leading-[0.88] tracking-[0.5px] bg-clip-text text-transparent whitespace-nowrap block"
              style="background-image: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
            >
              {item.number}
            </span>
            <div class="s5-mobile-proof-copy mt-1 flex w-full flex-col text-left">
              <p class="s5-stat-headline s5-mobile-proof-copy-line m-0 font-semibold text-[#FC558D]">{item.titleLine1}</p>
              <p class="s5-stat-headline s5-mobile-proof-copy-line m-0 font-semibold text-[#FC558D]">{item.titleLine2}</p>
            </div>
          </div>
          <div class="s5-mobile-proof-image curve-side relative mx-auto aspect-square w-full max-w-full overflow-hidden shadow-2xl will-change-[clip-path]" data-curve="side">
            <img src={item.image} alt={item.alt} class="s5-mobile-proof-photo absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover block will-change-transform" loading="lazy" decoding="async" draggable="false" />
            <div class="absolute inset-0 ring-1 ring-black/10 pointer-events-none rounded-[inherit]"></div>
          </div>
        </article>
        <!-- Divider after photo -->
        <div class="w-full h-[1px] bg-[#E1DDEC] flex-shrink-0" aria-hidden="true"></div>
      </>
    ))}

    <!-- Promise Quote with Official MadeWithGSAP Effect 066 Component (Figma Node 2053:2614) -->
    <div class="mwg_effect066 w-full relative py-8 px-0 my-0" data-node-id="2053:2614">
      <div class="container w-full p-0 m-0">
        <p id="s5-mwg-paragraph">
          Every piece is graded by hand at our table in Mumbai. We measure sugar, pressure, aroma and patience. Most fruit fails. What passes carries the mark and our promise: if a single piece isn’t right, we replace it before you finish telling us.
        </p>
      </div>
    </div>

    <!-- Divider after every piece promise -->
    <div class="w-full h-[1px] bg-[#E1DDEC] flex-shrink-0" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* Responsive Stage Sizing for Effect 037 Vertical Card */
  .s5-vertical-stage {
    width: clamp(230px, 66vw, 300px);
    height: clamp(300px, 44vh, 400px);
  }
  @media (min-width: 640px) {
    .s5-vertical-stage {
      width: 340px;
      height: 450px;
    }
  }
  @media (min-width: 951px) {
    .s5-vertical-stage {
      width: 420px;
      height: 560px;
    }
  }
  @media (min-width: 1280px) {
    .s5-vertical-stage {
      width: 512.8px;
      height: 682.1px;
    }
  }
  @media (min-width: 1920px) {
    .s5-vertical-stage {
      width: clamp(512px, 28vw, 620px);
      height: clamp(682px, 37vw, 825px);
    }
  }

  /* Section 5 Stat Headlines: Mobile (< 960px): Suisse Intl 32px / 34px / -1.2px / 600 SemiBold */
  .s5-stat-headline,
  .s5-mobile-proof-copy-line {
    font-family: 'Suisse Intl', sans-serif !important;
    font-weight: 600 !important;
    font-style: normal !important;
    font-size: 32px !important;
    line-height: 34px !important;
    letter-spacing: -1.2px !important;
    white-space: nowrap !important;
  }

  @media (max-width: 380px) {
    .s5-stat-headline,
    .s5-mobile-proof-copy-line {
      font-size: 29px !important;
      line-height: 32px !important;
      letter-spacing: -1.1px !important;
    }
  }

  /* Web / Desktop (>= 960px): Suisse Intl 52px / 52px / -1.6px / 600 SemiBold */
  @media (min-width: 960px) {
    .s5-stat-headline,
    .s5-mobile-proof-copy-line {
      font-family: 'Suisse Intl', sans-serif !important;
      font-size: clamp(44px, 3.61vw, 52px) !important;
      line-height: 52px !important;
      letter-spacing: -1.6px !important;
      font-weight: 600 !important;
    }
  }

  @media (min-width: 1440px) {
    .s5-stat-headline,
    .s5-mobile-proof-copy-line {
      font-size: 52px !important;
      line-height: 52px !important;
      letter-spacing: -1.6px !important;
    }
  }

  @media (min-width: 2200px) {
    .s5-stat-headline,
    .s5-mobile-proof-copy-line {
      font-size: 53px !important;
      line-height: 53px !important;
      letter-spacing: -1.6px !important;
    }
  }

  @media (min-width: 3000px) {
    .s5-stat-headline,
    .s5-mobile-proof-copy-line {
      font-size: 54px !important;
      line-height: 54px !important;
      letter-spacing: -1.6px !important;
    }
  }

  /* MadeWithGSAP Effect 066 Component (Adapted for Section 5 Mobile) */
  .mwg_effect066 {
    position: relative;
    width: 100%;
    background: #FDFEFF;
  }
  .mwg_effect066 .container {
    width: 100%;
    display: block;
    position: relative;
    padding: 0;
    margin: 0;
    background: #FDFEFF;
    box-sizing: border-box;
  }
  .mwg_effect066 .container p {
    --s5-grad-bottom: #FBF9D6;
    font-family: 'Suisse Intl', sans-serif !important;
    font-weight: 600 !important;
    font-size: 32px !important;
    line-height: 37px !important;
    letter-spacing: -1.4px !important;
    text-align: left !important;
    margin: 0;
    width: 100%;
    color: #FC558D;
  }
  @media (min-width: 380px) {
    .mwg_effect066 .container p {
      font-size: 35px !important;
      line-height: 38px !important;
    }
  }

  :global(.mwg_effect066 .line) {
    display: block;
    width: 100%;
    background-image: linear-gradient(180deg, #FC558D 0%, var(--s5-grad-bottom, #FBF9D6) 100%);
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    mask-image: linear-gradient(90deg, #000 -25%, transparent 0%);
    -webkit-mask-image: linear-gradient(90deg, #000 -25%, transparent 0%);
    will-change: mask-image, -webkit-mask-image;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  let mwgEffect066Trigger: ScrollTrigger | null = null

  const splitLinesForEffect066 = (paragraph: HTMLElement) => {
    const raw = "Every piece is graded by hand at our table in Mumbai. We measure sugar, pressure, aroma and patience. Most fruit fails. What passes carries the mark and our promise: if a single piece isn’t right, we replace it before you finish telling us."
    const words = raw.split(/\s+/)
    paragraph.innerHTML = words.map((w) => `<span class="s5-word inline-block mr-[0.24em]">${w}</span>`).join('')

    const spans = Array.from(paragraph.querySelectorAll<HTMLElement>('.s5-word'))
    if (!spans.length) return { lines: [] as HTMLElement[] }

    const linesMap: { [key: number]: HTMLElement[] } = {}
    spans.forEach((span) => {
      const top = Math.round(span.offsetTop)
      let foundKey: number | null = null
      for (const k of Object.keys(linesMap)) {
        if (Math.abs(top - Number(k)) <= 6) {
          foundKey = Number(k)
          break
        }
      }
      if (foundKey !== null) {
        linesMap[foundKey].push(span)
      } else {
        linesMap[top] = [span]
      }
    })

    const sortedTops = Object.keys(linesMap).map(Number).sort((a, b) => a - b)
    const lineTexts = sortedTops.map((top) => linesMap[top].map((s) => s.innerText).join(' '))

    paragraph.innerHTML = lineTexts.map((text) => `<div class="line">${text}</div>`).join('')

    const lines = Array.from(paragraph.querySelectorAll<HTMLElement>('.line'))
    const pRect = paragraph.getBoundingClientRect()
    const totalH = paragraph.offsetHeight || 450
    lines.forEach((l) => {
      const lRect = l.getBoundingClientRect()
      const relTop = Math.max(0, lRect.top - pRect.top)
      l.style.backgroundPosition = `0px -${relTop}px`
      l.style.backgroundSize = `100% ${totalH}px`
    })

    return { lines }
  }

  const initMwgEffect066 = () => {
    const root = document.querySelector<HTMLElement>('.mwg_effect066')
    if (!root) return

    const container = root.querySelector<HTMLElement>('.container')
    const paragraph = container?.querySelector<HTMLElement>('p')
    if (!container || !paragraph) return

    const isMobile = window.matchMedia('(max-width: 499px)').matches || document.documentElement.hasAttribute('data-mobile-static-copy')
    if (!isMobile) return

    if (mwgEffect066Trigger) {
      mwgEffect066Trigger.kill(true)
      mwgEffect066Trigger = null
    }

    const split = splitLinesForEffect066(paragraph)
    if (!split.lines.length) return

    // Explicitly initialize 25% feathered mask on every line
    gsap.set(split.lines, {
      maskImage: 'linear-gradient(90deg, #000 -25%, transparent 0%)',
      webkitMaskImage: 'linear-gradient(90deg, #000 -25%, transparent 0%)',
    })

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: paragraph,
        start: 'top 85%',
        end: 'bottom 35%',
        scrub: 0.5,
        onUpdate: (self) => {
          // Dynamic color interpolation from #FBF9D6 (251, 249, 214) to #FC558D (252, 85, 141)
          const p = self.progress
          const r = Math.round(251 + (252 - 251) * p)
          const g = Math.round(249 + (85 - 249) * p)
          const b = Math.round(214 + (141 - 214) * p)
          paragraph.style.setProperty('--s5-grad-bottom', `rgb(${r}, ${g}, ${b})`)
        },
      },
    })

    split.lines.forEach((line) => {
      tl.to(line, {
        maskImage: 'linear-gradient(90deg, #000 100%, transparent 125%)',
        webkitMaskImage: 'linear-gradient(90deg, #000 100%, transparent 125%)',
        ease: 'power1.inOut',
        duration: 1,
        onUpdate: function () {
          const target = this.targets()[0] as HTMLElement
          const v = target.style.maskImage || target.style.webkitMaskImage
          if (v) {
            target.style.webkitMaskImage = v
            target.style.maskImage = v
          }
        },
      }, '>-0.4')
    })

    mwgEffect066Trigger = tl.scrollTrigger ?? null
  }

  const initSection5Effect037 = () => {
    const section = document.querySelector<HTMLElement>('#section-5')
    if (!section) return

    const isPhoneLayout = window.matchMedia('(max-width: 1023px), (orientation: portrait) and (max-width: 1100px)').matches || document.documentElement.hasAttribute('data-mobile-static-copy')
    if (isPhoneLayout) {
      const fitMobileProofCopy = () => {
        const copyGroups = Array.from(section.querySelectorAll<HTMLElement>('.s5-mobile-proof-copy'))
        const lines = copyGroups.flatMap((group) => Array.from(group.querySelectorAll<HTMLElement>('.s5-mobile-proof-copy-line')))
        if (!lines.length) return

        lines.forEach((line) => {
          line.style.removeProperty('font-size')
          line.style.whiteSpace = 'nowrap'
          line.style.width = 'max-content'
        })

        const longestLineWidth = Math.max(...lines.map((line) => line.getBoundingClientRect().width))
        const availableWidth = section.clientWidth - 32
        const baseFontSize = Number.parseFloat(getComputedStyle(lines[0]).fontSize)
        if (!longestLineWidth || availableWidth <= 0 || !baseFontSize) return

        const fittedFontSize = `${baseFontSize * availableWidth / longestLineWidth}px`
        lines.forEach((line) => {
          line.style.fontSize = fittedFontSize
          line.style.width = '100%'
        })
      }

      let lastProofWidth = window.innerWidth
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastProofWidth) return
        lastProofWidth = window.innerWidth
        fitMobileProofCopy()
      }, { passive: true })
      void document.fonts.ready.then(() => requestAnimationFrame(fitMobileProofCopy))
      requestAnimationFrame(fitMobileProofCopy)

      // Parallax on Section 5 mobile proof images (maintains pure 1:1 squircle curve geometry)
      const mobileArticles = Array.from(section.querySelectorAll<HTMLElement>('.s5-mobile-proof'))
      mobileArticles.forEach((article) => {
        const imgPhoto = article.querySelector<HTMLElement>('.s5-mobile-proof-photo')
        if (!imgPhoto) return

        const cardTl = gsap.timeline({
          scrollTrigger: {
            trigger: article,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.4,
          },
        })

        cardTl.fromTo(
          imgPhoto,
          { yPercent: -6 },
          { yPercent: 6, ease: 'none', duration: 10 },
          0
        )
      })
    }

    const slides = Array.from(section.querySelectorAll<HTMLElement>('.s5-effect037-slide'))
    const images = Array.from(section.querySelectorAll<HTMLElement>('.s5-effect037-img'))
    const textSlides = Array.from(section.querySelectorAll<HTMLElement>('.s5-text-slide'))
    if (slides.length < 3 || textSlides.length < 3) return

    function renderEffect037(progress: number) {
      // Clamped progress between [0, 2]
      const p = Math.max(0, Math.min(2, progress))

      // Phase 1: Item 0 -> Item 1 (p from 0 to 1)
      const p1 = Math.max(0, Math.min(1, p))
      // Phase 2: Item 1 -> Item 2 (p from 1 to 2)
      const p2 = Math.max(0, Math.min(1, p - 1))

      // -----------------------------------------------------------------
      // 1. CENTER IMAGE SLIDES (Effect 037 Vertical Gradient Mask Wipe)
      // -----------------------------------------------------------------
      if (images[0]) {
        images[0].style.transform = 'scale(1.0)'
      }

      // Slide 1: Revealed over Slide 0
      if (slides[1] && images[1]) {
        if (p1 <= 0.001) {
          slides[1].style.webkitMaskImage = 'linear-gradient(180deg, transparent 0%, transparent 100%)'
          slides[1].style.maskImage = 'linear-gradient(180deg, transparent 0%, transparent 100%)'
          images[1].style.transform = 'scale(1.0)'
        } else if (p1 >= 0.999) {
          slides[1].style.webkitMaskImage = 'none'
          slides[1].style.maskImage = 'none'
          images[1].style.transform = 'scale(1.0)'
        } else {
          const stop1 = Math.max(0, p1 * 130 - 30)
          const stop2 = Math.min(100, p1 * 130)
          const maskVal = `linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) ${stop1}%, rgba(0,0,0,0) ${stop2}%, rgba(0,0,0,0) 100%)`
          slides[1].style.webkitMaskImage = maskVal
          slides[1].style.maskImage = maskVal
          images[1].style.transform = 'scale(1.0)'
        }
      }

      // Slide 2: Revealed over Slide 1
      if (slides[2] && images[2]) {
        if (p2 <= 0.001) {
          slides[2].style.webkitMaskImage = 'linear-gradient(180deg, transparent 0%, transparent 100%)'
          slides[2].style.maskImage = 'linear-gradient(180deg, transparent 0%, transparent 100%)'
          images[2].style.transform = 'scale(1.0)'
        } else if (p2 >= 0.999) {
          slides[2].style.webkitMaskImage = 'none'
          slides[2].style.maskImage = 'none'
          images[2].style.transform = 'scale(1.0)'
        } else {
          const stop1 = Math.max(0, p2 * 130 - 30)
          const stop2 = Math.min(100, p2 * 130)
          const maskVal = `linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) ${stop1}%, rgba(0,0,0,0) ${stop2}%, rgba(0,0,0,0) 100%)`
          slides[2].style.webkitMaskImage = maskVal
          slides[2].style.maskImage = maskVal
          images[2].style.transform = 'scale(1.0)'
        }
      }

      // -----------------------------------------------------------------
      // 2. LEFT SIDE TEXT SLIDES (Effect 037 Gradient Mask Wipe & Drift)
      // -----------------------------------------------------------------
      // Under 500px, retain the scroll-linked content but switch text in one
      // step, without translating or wiping the words.
      if (window.matchMedia('(max-width: 1023px), (orientation: portrait) and (max-width: 1100px)').matches || document.documentElement.hasAttribute('data-mobile-static-copy')) {
        const activeText = Math.min(2, Math.floor(p + 0.0001))
        textSlides.forEach((slide, index) => {
          slide.style.display = index === activeText ? 'flex' : 'none'
          slide.style.opacity = '1'
          slide.style.transform = 'none'
          slide.style.webkitMaskImage = 'none'
          slide.style.maskImage = 'none'
        })
        return
      }

      if (p < 1) {
        // Transition from Text Slide 0 -> Text Slide 1
        textSlides[2].style.display = 'none'

        if (p1 <= 0.001) {
          textSlides[0].style.display = 'flex'
          textSlides[0].style.opacity = '1'
          textSlides[0].style.transform = 'translateY(0px)'
          textSlides[0].style.webkitMaskImage = 'none'
          textSlides[0].style.maskImage = 'none'

          textSlides[1].style.display = 'none'
        } else if (p1 >= 0.999) {
          textSlides[0].style.display = 'none'

          textSlides[1].style.display = 'flex'
          textSlides[1].style.opacity = '1'
          textSlides[1].style.transform = 'translateY(0px)'
          textSlides[1].style.webkitMaskImage = 'none'
          textSlides[1].style.maskImage = 'none'
        } else {
          textSlides[0].style.display = 'flex'
          textSlides[0].style.opacity = Math.max(0, 1 - p1 * 1.5).toString()
          textSlides[0].style.transform = `translateY(${-p1 * 16}px)`
          textSlides[0].style.webkitMaskImage = 'none'
          textSlides[0].style.maskImage = 'none'

          textSlides[1].style.display = 'flex'
          textSlides[1].style.opacity = Math.min(1, p1 * 1.5).toString()
          textSlides[1].style.transform = `translateY(${(1 - p1) * 16}px)`

          const stop1 = Math.max(0, p1 * 130 - 30)
          const stop2 = Math.min(100, p1 * 130)
          const maskVal = `linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,1) ${stop1}%, rgba(0,0,0,0) ${stop2}%, rgba(0,0,0,0) 100%)`
          textSlides[1].style.webkitMaskImage = maskVal
          textSlides[1].style.maskImage = maskVal
        }
