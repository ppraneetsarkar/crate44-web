          <div class="the-list-btn will-change-transform shrink-0 w-max opacity-0 invisible pointer-events-none">
            <button
              class="relative inline-block text-center uppercase font-display font-semibold text-[32px] leading-[34px] px-4 md:px-8 py-2"
            >
              JOIN THE LIST
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
)}

<!-- ============================================================== -->
<!-- 2. GLOBAL FOOTER (<footer>)                                    -->
<!-- ============================================================== -->
<footer class="w-full bg-[#131313] mt-auto flex flex-col" aria-label="Site Footer">
  <!-- ──────────────────────────────────────────────────────────── -->
  <!-- MOBILE FOOTER: Fruit Parallax Card (<768px)                   -->
  <!-- ──────────────────────────────────────────────────────────── -->
  <div
    class="footer-parallax-card flex md:hidden flex-col justify-start items-start pt-[100px] pb-[30px] w-full relative overflow-hidden bg-[#131313] min-h-[540px]"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div
        class="footer-parallax-bg absolute -top-[15%] left-0 w-full h-[130%] bg-cover bg-center will-change-transform"
        style="background-image: url('/images/footer/footer-bg.webp'); background-repeat: no-repeat;"
      ></div>
      <div
        class="absolute inset-0 z-[1]"
        style="background: linear-gradient(180deg, #131313 0%, rgba(10, 10, 10, 0.51) 48%, #131313 96%, #131313 100%); box-shadow: inset 0 12px 36px 0 #131313, inset 0 -12px 36px 0 #131313;"
      ></div>
    </div>
    <div class="px-4 z-10 w-full">
      <div class="w-full mx-auto">
        <h2 class="m-0 p-0 flex flex-col items-start z-10 w-full">
          <span class="block overflow-hidden pb-[0.08em]">
            <span
              class="footer-fruit-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform text-left font-display font-semibold text-[clamp(56px,18vw,92px)] min-[650px]:text-[92px] leading-[76px] uppercase"
              style="background: linear-gradient(180deg, #F8FE03 0%, #E1DDEC 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
              data-line="THE FRUIT"
            >
              <span class="footer-fruit-char inline-block">T</span>
              <span class="footer-fruit-char inline-block">H</span>
              <span class="footer-fruit-char inline-block">E</span>
              <span class="footer-fruit-char inline-block">&nbsp;</span>
              <span class="footer-fruit-char inline-block">F</span>
              <span class="footer-fruit-char inline-block">R</span>
              <span class="footer-fruit-char inline-block">U</span>
              <span class="footer-fruit-char inline-block">I</span>
              <span class="footer-fruit-char inline-block">T</span>
            </span>
          </span>
          <span class="block overflow-hidden pb-[0.08em]">
            <span
              class="footer-fruit-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform text-left font-display font-semibold text-[clamp(56px,18vw,92px)] min-[650px]:text-[92px] leading-[76px] uppercase"
              style="background: linear-gradient(180deg, #F8FE03 0%, #E1DDEC 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
              data-line="HOUSE OF"
            >
              <span class="footer-fruit-char inline-block">H</span>
              <span class="footer-fruit-char inline-block">O</span>
              <span class="footer-fruit-char inline-block">U</span>
              <span class="footer-fruit-char inline-block">S</span>
              <span class="footer-fruit-char inline-block">E</span>
              <span class="footer-fruit-char inline-block">&nbsp;</span>
              <span class="footer-fruit-char inline-block">O</span>
              <span class="footer-fruit-char inline-block">F</span>
            </span>
          </span>
          <span class="block overflow-hidden pb-[0.08em]">
            <span
              class="footer-fruit-reveal-line flex flex-nowrap whitespace-nowrap will-change-transform text-left font-display font-semibold text-[clamp(56px,18vw,92px)] min-[650px]:text-[92px] leading-[76px] uppercase"
              style="background: linear-gradient(180deg, #F8FE03 0%, #E1DDEC 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
              data-line="INDIA"
