<!-- Section 3 Styling & Dynamic Fluid Typography -->
<style>
  .bg-gradient-s3 {
    background: #131313;
  }

  .text-gradient-s3 {
    background: linear-gradient(180deg, #3ED5FF 0%, white 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Mobile: scales fluidly with viewport, exact 90px line-height at 115px font size (90/115 ratio = ~0.7826em) auto-scaling */
  .text-fluid-s3-mob {
    font-size: clamp(72px, 29.5vw, 120px);
    line-height: calc(90 / 115);
  }

  /* Desktop (≥1280px): scales proportionally (296px at 1440px canvas = 20.55vw) */
  @media (min-width: 951px) {
  }
</style>

<!-- Scripts: Scroll-linked upward text movement with the existing Section 3 styling -->
<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  let luxuryEase: gsap.EaseFunction
  try {
    luxuryEase = CustomEase.create('luxuryS3Fluid', '0.16, 1, 0.3, 1')
  } catch (e) {
    luxuryEase = gsap.parseEase('power3.out')
  }

  function setupSection3() {
    // Match the actual `lg` layout switch in tailwind.config.mjs (950px).
    const isMobile = window.innerWidth < 950
    const triggerTarget = isMobile
      ? document.querySelector('.s3-headline-mob')
      : document.querySelector('.s3-headline-desk-line1')

    if (!triggerTarget) return

    const activeContainer = isMobile
      ? document.querySelector('.s3-headline-mob')
      : document.querySelector('.s3-content-desk')

    if (!activeContainer) return

    const lines = activeContainer.querySelectorAll<HTMLElement>('.s3-roll-line')
    const imgCard = isMobile
      ? document.getElementById('s3-image-card-mob')
      : document.getElementById('s3-image-card-desk')
    const btn = isMobile
      ? document.getElementById('s3-btn-mob')
      : document.getElementById('s3-btn-desk')
    const imgEl = isMobile
      ? document.getElementById('s3-image-mob')
      : document.getElementById('s3-image-desk')

    // Reveal one complete line at a time, with each reveal directly tied to
    // scroll progress. Completed lines remain visible while the next line moves.
    gsap.set(lines, { yPercent: 115, opacity: 0 })

    const textReveal = gsap.timeline({
      scrollTrigger: {
        trigger: activeContainer,
        start: 'top 85%',
        end: () => `+=${activeContainer.clientHeight + window.innerHeight * 0.5}`,
        scrub: true,
        invalidateOnRefresh: true,
      },
    })

    textReveal.to(lines, {
      yPercent: 0,
      opacity: 1,
      ease: 'none',
      duration: 1,
      stagger: 1,
    })

    if (imgCard) {
      gsap.set(imgCard, { opacity: 0, y: 40 })
    }

    if (btn) {
      gsap.set(btn, { opacity: 1, y: 0 })
    }

    const mediaTl = gsap.timeline({
      scrollTrigger: {
        trigger: triggerTarget,
        start: 'top 70%',
        once: true,
      },
    })

    if (imgCard) {
      mediaTl.to(imgCard, {
        opacity: 1,
        y: 0,
        duration: 1.3,
        ease: luxuryEase,
      }, 0.25)
    }

    if (btn) {
      mediaTl.to(btn, {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: luxuryEase,
      }, 0.4)
    }

    if (imgCard && imgEl) {
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0
      const cardTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#section-3',
          start: 'top bottom',
          end: 'bottom top',
          scrub: isTouchDevice ? 0.4 : 0.6,
        },
      })

      // Effect 121: Aperture clip-path shutter on image card
      const clipObj = { y: 10 }
      cardTl.fromTo(
        clipObj,
        { y: 10 },
        {
          y: 0,
          ease: 'none',
          duration: 3,
          onUpdate: () => {
            imgCard.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
          },
        }
      )
      .to(clipObj, {
        y: 0,
        ease: 'none',
        duration: 4,
        onUpdate: () => {
          imgCard.style.clipPath = 'inset(0% 0px round 14px)'
        },
      })
      .to(clipObj, {
        y: 10,
        ease: 'none',
        duration: 3,
        onUpdate: () => {
          imgCard.style.clipPath = `inset(${clipObj.y.toFixed(2)}% 0px round 14px)`
        },
      })

      // Smooth vertical counter-parallax on inner image
      cardTl.fromTo(
        imgEl,
        { yPercent: -6 },
        { yPercent: 6, ease: 'none', duration: 10 },
        0
      )
    }
  }

  setTimeout(() => {
    setupSection3()
    ScrollTrigger.refresh()

    // GSAP Corner-Morphing & Rolling Text FX for Section 3 Solo Buttons
    document.querySelectorAll<HTMLElement>('.s3-btn-morph').forEach((btn) => {
      const textTop = btn.querySelector<HTMLElement>('.roll-text-top')
      const textBottom = btn.querySelector<HTMLElement>('.roll-text-bottom')

      gsap.set(btn, {
        borderTopLeftRadius: '28px',
        borderBottomLeftRadius: '28px',
        borderTopRightRadius: '28px',
        borderBottomRightRadius: '28px',
      })

      if (textTop && textBottom) {
        gsap.set(textTop, { yPercent: 0, filter: 'blur(0px)' })
        gsap.set(textBottom, { yPercent: 100, filter: 'blur(3.5px)' })
      }

      btn.addEventListener('mouseenter', () => {
        // Solo button -> Morphs on LEFT (14px 28px 28px 14px)
        gsap.to(btn, {
          borderTopLeftRadius: '14px',
          borderBottomLeftRadius: '14px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.45,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        }
      })

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '28px',
          borderBottomLeftRadius: '28px',
          borderTopRightRadius: '28px',
          borderBottomRightRadius: '28px',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        }
      })
    })
  }, 150)

  let lastTriggerWidth = window.innerWidth
  window.addEventListener('resize', () => {
    if (window.innerWidth === lastTriggerWidth) return
    lastTriggerWidth = window.innerWidth
    ScrollTrigger.refresh()
  }, { passive: true })
</script>
