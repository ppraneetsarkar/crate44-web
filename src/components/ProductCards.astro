              class="card-inner curve-straight relative flex flex-col select-none overflow-hidden w-[280px] sm:w-[320px] md:w-[360px] lg:w-[462px] h-[380px] sm:h-[420px] md:h-[460px] lg:h-[566px] border-[4px] lg:border-[6px] border-[#F8FE03] border-solid"
              data-curve="straight"
              style="max-width: calc(100vw - 32px); box-shadow: 0 0 44px 0 rgba(0, 0, 0, 0.01);"
            >
              <!-- Frosted Background Layer: ACTIVE ONLY ON MIDDLE CARD (Seamless Native GPU Backdrop Blur) -->
              <div
                class="card-blur-overlay absolute -inset-[6px] rounded-[inherit] -z-10 pointer-events-none transition-opacity duration-300 bg-white/[0.14] backdrop-blur-[14px] [-webkit-backdrop-blur:14px]"
                style="opacity: 0; display: none;"
              />

              <!-- 3D Canvas Layer: Embedded Three.js Viewer -->
              <div
                class="card-3d-container absolute inset-0 z-0 pointer-events-none flex items-center justify-center overflow-hidden"
                data-3d-file={fruit.threeDFile || ''}
              />

              <!-- Top-Left: Fruit Name (Figma Spacing: left 11px, top 10px from stroke edge) -->
              <div
                class="absolute left-[8px] sm:left-[11px] top-[7px] sm:top-[10px] z-10 uppercase text-left font-display font-semibold text-[32px] sm:text-[40px] md:text-[44px] lg:text-[56px] leading-[30px] sm:leading-[38px] md:leading-[42px] lg:leading-[52px]"
                style="color: #F8FE03;"
              >
                <p class="m-0 leading-[30px] sm:leading-[38px] md:leading-[42px] lg:leading-[52px]">{fruit.titleLine1}</p>
                <p class="m-0 leading-[30px] sm:leading-[38px] md:leading-[42px] lg:leading-[52px]">{fruit.titleLine2}</p>
              </div>

              <!-- Top-Right: Price Badge (Figma Node 1838:2042: rounded-bl-[28px] rounded-br-[4px] rounded-tr-[28px]) -->
