<section
  id="product-cards"
  class="relative w-full overflow-hidden select-none pt-16 sm:pt-24 md:pt-32 lg:pt-44 pb-10 md:pb-20 lg:pb-24"
  style="background-image:url('/images/section-4-bg.avif');background-size:cover;background-position:center"
>
  <style is:global>
    @keyframes cardMarqueeAnim {
      0% {
        transform: translateX(0%);
      }
      100% {
        transform: translateX(-50%);
      }
    }
    .card-marquee-wrap {
      overflow: hidden !important;
      contain: paint !important;
    }
    .card-marquee-scroll {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      white-space: nowrap !important;
      will-change: transform !important;
      animation: cardMarqueeAnim 12s linear infinite !important;
    }
    .card-marquee-scroll span {
      display: inline-block !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      line-height: 1 !important;
    }
  </style>

  <!-- Sky gradient overlays -->
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background:linear-gradient(180deg, rgba(225, 221, 236, 0.45) 0%, rgba(238, 238, 242, 0.25) 50%, rgba(215, 212, 226, 0.45) 100%)"
  >
  </div>
  <div
    class="absolute top-0 left-0 right-0 h-14 md:h-28 pointer-events-none z-10"
    style="background:linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, transparent 100%)"
  >
  </div>

  <!-- Figma Node 1570:3680 · Gradient layer filling vertically, fixed to bottom for smooth transition to next section (#FDFEFF) -->
  <div
    id="section-4-gradient-layer"
    aria-hidden="true"
    class="absolute inset-0 w-full h-full pointer-events-none z-10"
    data-node-id="1570:3680"
    style="background: linear-gradient(180deg, rgba(253, 254, 255, 0) 0%, rgba(253, 254, 255, 0) 55%, rgba(253, 254, 255, 0.45) 75%, #FDFEFF 100%);"
  >
  </div>

  <div class="max-w-[1600px] mx-auto w-full flex flex-col items-center justify-center relative z-20">
    <!-- Carousel Stage Container -->
    <div
      id="cards-stage"
      class="w-full relative h-[500px] sm:h-[560px] md:h-[600px] lg:h-[720px] flex items-center justify-center overflow-visible cursor-grab active:cursor-grabbing touch-pan-y"
      style="cursor: grab; touch-action: pan-y;"
    >
      {
        fruits.map((fruit, idx) => (
          <div
            class="card-wrapper absolute flex flex-col items-center will-change-transform transform-gpu"
            data-fruit-id={fruit.id}
            data-index={idx}
            style="transform: translate3d(0px, 0px, 0px) scale(1); z-index: 30; opacity: 1; pointer-events: auto;"
