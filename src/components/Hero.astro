      <source src="/videos/hero.webm" type="video/webm" />
    </video>
  </div>

  <!-- Exact Figma Gradient Layer (Node 1574:5033): Fills vertically across entire section for seamless transition to Section 2 -->
  <div
    id="hero-gradient-layer"
    aria-hidden="true"
    class="absolute inset-0 w-full h-full pointer-events-none z-[1]"
    data-node-id="1574:5033"
    style="background-image: linear-gradient(180deg, rgba(19, 19, 19, 0.5) 0%, rgba(19, 19, 19, 0.5) 27.993%, rgba(19, 19, 19, 0) 56.251%, rgba(19, 19, 19, 0.85) 85%, rgb(19, 19, 19) 100%);"
