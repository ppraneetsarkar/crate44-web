              class="card-price-badge absolute z-10 uppercase flex items-baseline justify-center tracking-tight select-none font-display font-semibold -top-[3px] -right-[3px] pt-[6px] sm:pt-[8px] pb-[7px] sm:pb-[9px] pl-[8px] sm:pl-[10px] pr-[12px] sm:pr-[16px] rounded-bl-[16px] sm:rounded-bl-[22px] rounded-br-[3px] rounded-tr-[16px] sm:rounded-tr-[22px] bg-[#F8FE03] text-[#131313] text-center text-[24px] sm:text-[32px] md:text-[38px] leading-none gap-[2px]"
            >
