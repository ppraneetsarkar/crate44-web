<!-- Dynamic Font Scaling Rules for Hero -->
<style>
  /* Responsive typography scaling for hero headline */
  @media (max-width: 949px) {
    #hero-headline {
      font-family: 'VVDS Fifties', 'VVDS_Fifties', sans-serif;
      font-size: clamp(56px, calc(3.5778vw + 68px), 88px);
      line-height: clamp(50px, calc(3.2200vw + 58px), 74px);
      letter-spacing: calc(0.03578vw + 0.4605px);
    }
  }

  @media (min-width: 950px) and (max-width: 4096px) {
    #hero-headline {
      font-family: 'VVDS Fifties', 'VVDS_Fifties', sans-serif;
      font-size: calc(5.8487vw + 56.437px);
      line-height: calc(4.6408vw + 49.913px);
      letter-spacing: calc(0.03814vw + 0.438px);
    }
  }

  /* The foldable's 950px viewport uses the desktop hero composition. */
  @media (min-width: 950px) {
    #hero-section {
      flex-direction: row !important;
      align-items: flex-end !important;
      padding-top: clamp(48px, 6vh, 80px);
      padding-bottom: clamp(24px, 4vh, 48px);
    }

    #hero-section > .relative.z-10 {
      flex-direction: row !important;
      align-items: flex-end !important;
      justify-content: space-between !important;
    }

    #hero-section > .relative.z-10 > div:first-child {
      align-items: flex-start !important;
      justify-content: flex-end !important;
      text-align: left !important;
      margin-top: 0;
      margin-bottom: 0;
      padding-top: 0;
      padding-bottom: 0;
      flex: 1 0 0%;
      width: auto;
    }

    #hero-section .roll-line { justify-content: flex-start !important; }
    #hero-section [data-node-id="1821:4707"] { display: none !important; }
    #hero-section [data-node-id="1574:5016"] { display: block !important; }
    #hero-section [data-node-id="1821:4708"] {
      width: min(532px, 100%);
      flex-shrink: 0;
      gap: 28px;
      align-items: flex-start;
      margin-top: 0;
      padding-top: 0;
    }
  }

</style>

<!-- Scripts: Luxury CustomEase Smooth Flow + GSAP -->
<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  const easeLuxury = 'cubic-bezier(0.31, 0.75, 0.22, 1)'

  const lines = document.querySelectorAll<HTMLElement>('.roll-line')
  const buttonsRow = document.querySelector<HTMLElement>('.buttons-row')

  gsap.set(lines, {
    yPercent: 140,
    opacity: 0,
    rotate: 0.001,
  })

  gsap.set('.hero-copy', { opacity: 0, y: 30 })
  if (buttonsRow) {
    gsap.set(buttonsRow, { yPercent: 120, opacity: 0 })
  }

  const masterTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#hero-section',
      start: 'top 85%',
      once: true,
    },
    delay: 0.15,
  })

  masterTl.to(lines, {
    yPercent: 0,
    opacity: 1,
    rotate: 0,
    duration: 1.1,
    ease: easeLuxury,
    stagger: 0.0825,
  }, 0)

  masterTl.to('.hero-copy', {
    opacity: 1,
    y: 0,
    duration: 1.0,
    ease: easeLuxury,
  }, 0.28)

  if (buttonsRow) {
    masterTl.to(buttonsRow, {
      yPercent: 0,
      opacity: 1,
      duration: 1.1,
      ease: easeLuxury,
    }, 0.38)
  }

  // GSAP Corner-Morphing & Rolling Text FX for Paired Hero Buttons
  const btnJoin = document.getElementById('btn-join')
  const btnEdit = document.getElementById('btn-edit')

  if (btnJoin) {
    const textTop = btnJoin.querySelector<HTMLElement>('.roll-text-top')
    const textBottom = btnJoin.querySelector<HTMLElement>('.roll-text-bottom')

    gsap.set(btnJoin, {
      borderTopLeftRadius: '28px',
      borderBottomLeftRadius: '28px',
      borderTopRightRadius: '28px',
      borderBottomRightRadius: '28px',
    })

    if (textTop && textBottom) {
      gsap.set(textTop, { yPercent: 0, filter: 'blur(0px)' })
      gsap.set(textBottom, { yPercent: 100, filter: 'blur(3.5px)' })
    }

    btnJoin.addEventListener('mouseenter', () => {
      // Left button in pair -> Morphs on RIGHT (28px 14px 14px 28px)
      gsap.to(btnJoin, {
        borderTopRightRadius: '14px',
        borderBottomRightRadius: '14px',
        borderTopLeftRadius: '28px',
        borderBottomLeftRadius: '28px',
        duration: 0.45,
        ease: 'power3.out',
        overwrite: 'auto',
      })

      if (textTop && textBottom) {
        gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
      }
    })

    btnJoin.addEventListener('mouseleave', () => {
      gsap.to(btnJoin, {
        borderTopRightRadius: '28px',
        borderBottomRightRadius: '28px',
        borderTopLeftRadius: '28px',
        borderBottomLeftRadius: '28px',
        duration: 0.38,
        ease: 'power3.out',
        overwrite: 'auto',
      })

      if (textTop && textBottom) {
        gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
      }
    })
  }

  if (btnEdit) {
    const textTop = btnEdit.querySelector<HTMLElement>('.roll-text-top')
    const textBottom = btnEdit.querySelector<HTMLElement>('.roll-text-bottom')

    gsap.set(btnEdit, {
      borderTopLeftRadius: '28px',
      borderBottomLeftRadius: '28px',
      borderTopRightRadius: '28px',
      borderBottomRightRadius: '28px',
    })

    if (textTop && textBottom) {
      gsap.set(textTop, { yPercent: 0, filter: 'blur(0px)' })
      gsap.set(textBottom, { yPercent: 100, filter: 'blur(3.5px)' })
    }

    btnEdit.addEventListener('mouseenter', () => {
      // Right button in pair -> Morphs on LEFT (14px 28px 28px 14px)
      gsap.to(btnEdit, {
        borderTopLeftRadius: '14px',
        borderBottomLeftRadius: '14px',
        borderTopRightRadius: '28px',
        borderBottomRightRadius: '28px',
        duration: 0.45,
        ease: 'power3.out',
        overwrite: 'auto',
      })

      if (textTop && textBottom) {
        gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
      }
    })

    btnEdit.addEventListener('mouseleave', () => {
      gsap.to(btnEdit, {
        borderTopLeftRadius: '28px',
        borderBottomLeftRadius: '28px',
        borderTopRightRadius: '28px',
        borderBottomRightRadius: '28px',
        duration: 0.38,
        ease: 'power3.out',
        overwrite: 'auto',
      })

      if (textTop && textBottom) {
        gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
      }
    })
  }

  // Let the browser stream the original video directly instead of buffering a
  // second full copy in JavaScript memory. Pause decoding while the hero is away.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null
  if (heroVideo) {
    heroVideo.muted = true
    heroVideo.defaultMuted = true
    heroVideo.playsInline = true

    let hasCompletedPlayback = false

    const onPlaybackComplete = () => {
      if (hasCompletedPlayback) return
      hasCompletedPlayback = true
      heroVideo.pause()
    }

    heroVideo.addEventListener('ended', onPlaybackComplete)
    heroVideo.addEventListener('timeupdate', () => {
      if (!hasCompletedPlayback && heroVideo.duration > 1) {
        if (heroVideo.currentTime >= heroVideo.duration - 0.08) {
          onPlaybackComplete()
        }
      }
    })

    const tryPlayHero = () => {
      if (hasCompletedPlayback) return
      if (heroVideo.paused) {
        heroVideo.play().catch(() => {})
      }
    }
    tryPlayHero()

    // Unlock on first mobile interaction (bypasses iOS Low Power Mode autoplay restriction)
    const unlockHeroVideo = () => {
      if (!hasCompletedPlayback) tryPlayHero()
      window.removeEventListener('touchstart', unlockHeroVideo)
      window.removeEventListener('pointerdown', unlockHeroVideo)
      window.removeEventListener('scroll', unlockHeroVideo)
    }
    window.addEventListener('touchstart', unlockHeroVideo, { passive: true })
    window.addEventListener('pointerdown', unlockHeroVideo, { passive: true })
    window.addEventListener('scroll', unlockHeroVideo, { passive: true })

    const heroVisibility = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!hasCompletedPlayback) tryPlayHero()
      } else {
        if (!hasCompletedPlayback) heroVideo.pause()
      }
    }, { threshold: 0.01 })
    heroVisibility.observe(heroVideo)

    let wasPlayingBeforeMenu = false
    window.addEventListener('crate44:nav-open', () => {
      const currentVideo = document.getElementById('hero-video') as HTMLVideoElement | null
      if (!currentVideo) return
      wasPlayingBeforeMenu = !currentVideo.paused && !currentVideo.ended && !hasCompletedPlayback
      currentVideo.pause()
    })
    window.addEventListener('crate44:nav-closed', () => {
      const currentVideo = document.getElementById('hero-video') as HTMLVideoElement | null
      if (!currentVideo) return
      const rect = currentVideo.getBoundingClientRect()
      const isVisible = rect.bottom > 0 && rect.top < window.innerHeight
      if (!hasCompletedPlayback && wasPlayingBeforeMenu && isVisible && !currentVideo.ended) {
        currentVideo.play().catch(() => {})
      }
      wasPlayingBeforeMenu = false
    })
  }

  // Subtle hero video background parallax (gradient layer stays static and fully anchored)
  const heroVideoEl = document.getElementById('hero-video')
  if (heroVideoEl) {
    gsap.to(heroVideoEl, {
      yPercent: 8,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero-section',
        start: 'top top',
        end: 'bottom top',
        scrub: ScrollTrigger.isTouch ? true : 0.6,
      },
    })
  }
</script>
