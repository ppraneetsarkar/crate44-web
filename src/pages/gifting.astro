---
// src/pages/gifting.astro
// Exact implementation ported from https://crate44.in/gifting
// Mobile responsiveness fixed, guaranteed visibility, and unified fonts

import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'

const crateCards = [
  {
    titleLine1: 'THE EDIT',
    titleLine2: 'CRATE',
    img: '/webp/edit-crate.webp',
    desc: "This week's best, arranged.",
    price: 'From ₹6,500.',
  },
  {
    titleLine1: 'THE SEASON',
    titleLine2: 'CRATE',
    img: '/webp/season-crate.webp',
    desc: 'One grower. One peak. Twelve units.',
    price: 'From ₹4,500.',
  },
  {
    titleLine1: 'THE HOUSE',
    titleLine2: 'CRATE',
    img: '/webp/house-crate.webp',
    desc: 'The weekly foundation for households.',
    price: 'From ₹8,500.',
  },
]
---

<Layout title="The Gift Crate | Crate 44 — FruitSite">
  <main class="min-h-screen w-full overflow-x-clip bg-black selection:bg-[#F8FE03] selection:text-black">
    <!-- Section 1: Hero — THE GIFT CRATE -->
    <section
      id="gifting-hero"
      class="relative w-full max-h-[956px] min-h-[100dvh] md:h-[917px] overflow-hidden flex flex-col justify-between pt-[130px] sm:pt-[140px] pb-0 bg-black"
    >
      <!-- Background Hero Visual (Frame 1686553617) -->
      <div class="absolute inset-0 pointer-events-none select-none z-0">
        <picture>
          <img
            src="/images/gifting-hero.avif"
            alt="The Gift Crate"
            class="w-full h-full object-cover object-bottom pointer-events-none"
            loading="eager"
            decoding="async"
          />
        </picture>
        <!-- Seamless fade to Section 2 (#111111) -->
        <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#111111] to-transparent pointer-events-none"></div>
      </div>

      <div class="px-4 lg:px-8 relative z-10 w-full flex-1 flex flex-col items-center justify-start text-center">
        <div class="w-full mx-auto flex flex-col items-center justify-start">
          <div class="w-full flex flex-col items-center text-center">
            <h1 class="m-0 p-0 text-center w-full">
              <!-- Desktop Headline -->
              <div class="hidden md:flex flex-col items-center">
                <span class="block overflow-hidden pb-[0.08em]">
                  <span
                    class="gift-hero-line flex flex-nowrap whitespace-nowrap justify-center will-change-transform uppercase font-display font-semibold text-[140px] leading-[115px] lg:text-[200px] lg:leading-[162px] tracking-[2.8px]"
                    style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                    data-line="THE GIFT"
                  >
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                    <span class="gift-hero-char inline-block will-change-transform">H</span>
                    <span class="gift-hero-char inline-block will-change-transform">E</span>
                    <span class="gift-hero-char inline-block will-change-transform">&nbsp;</span>
                    <span class="gift-hero-char inline-block will-change-transform">G</span>
                    <span class="gift-hero-char inline-block will-change-transform">I</span>
                    <span class="gift-hero-char inline-block will-change-transform">F</span>
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                  </span>
                </span>
                <span class="block overflow-hidden pb-[0.08em]">
                  <span
                    class="gift-hero-line flex flex-nowrap whitespace-nowrap justify-center will-change-transform uppercase font-display font-semibold text-[140px] leading-[115px] lg:text-[200px] lg:leading-[162px] tracking-[2.8px]"
                    style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                    data-line="CRATE"
                  >
                    <span class="gift-hero-char inline-block will-change-transform">C</span>
                    <span class="gift-hero-char inline-block will-change-transform">R</span>
                    <span class="gift-hero-char inline-block will-change-transform">A</span>
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                    <span class="gift-hero-char inline-block will-change-transform">E</span>
                  </span>
                </span>
              </div>

              <!-- Mobile Headline -->
              <div class="flex md:hidden flex-col items-center">
                <span class="block overflow-hidden pb-[0.05em]">
                  <span
                    class="gift-hero-line flex flex-nowrap whitespace-nowrap justify-center will-change-transform uppercase font-display font-semibold text-[80px] sm:text-[100px] leading-[72px] sm:leading-[90px] tracking-[0.8px]"
                    style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                    data-line="THE"
                  >
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                    <span class="gift-hero-char inline-block will-change-transform">H</span>
                    <span class="gift-hero-char inline-block will-change-transform">E</span>
                  </span>
                </span>
                <span class="block overflow-hidden pb-[0.05em]">
                  <span
                    class="gift-hero-line flex flex-nowrap whitespace-nowrap justify-center will-change-transform uppercase font-display font-semibold text-[80px] sm:text-[100px] leading-[72px] sm:leading-[90px] tracking-[0.8px]"
