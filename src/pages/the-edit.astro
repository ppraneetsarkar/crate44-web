<style>
  /* FruitTiltWheel Module Styles (Tutorial 106 & crate44.in) */
  .FruitTiltWheel-module__VaPV9W__mwg_effect106 {
    overflow: visible;
  }
  .FruitTiltWheel-module__VaPV9W__container {
    transform-style: preserve-3d;
  }
  .FruitTiltWheel-module__VaPV9W__medias {
    transform-style: preserve-3d;
  }
  .FruitTiltWheel-module__VaPV9W__media {
    transform-style: preserve-3d;
    position: absolute;
    top: 50%;
    left: 50%;
  }

  /* 3D Cube Flip CTA Button */
  .flip-btn:hover .flip-inner,
  .card-order-btn:hover .flip-inner {
    transform: rotateX(90deg);
  }

  /* Bottom card window marquee strip */
  @keyframes cardFooterMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .card-footer-marquee {
    display: flex;
    width: max-content;
    animation: cardFooterMarquee 8s linear infinite;
  }

  /* Infinite Ledger Marquee Ribbon */
  @keyframes returnMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: returnMarquee 18s linear infinite;
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { CustomEase } from 'gsap/CustomEase'

  gsap.registerPlugin(ScrollTrigger, CustomEase)

  function initTheEdit() {
    // 1. 3D Fruit Tilt Wheel (Made With GSAP Tutorial 106 & crate44.in exact logic)
    const wheelSection = document.getElementById('tilt-wheel-section')
    const mediasContainer = document.getElementById('tilt-medias')
    const mediaEls = document.querySelectorAll<HTMLElement>('.fruit-wheel-item')
    const iframes = document.querySelectorAll<HTMLIFrameElement>('.fruit-wheel-iframe')

    if (wheelSection && mediasContainer && mediaEls.length > 0) {
      const angles = Array.from({ length: mediaEls.length }, (_, i) => (i / mediaEls.length) * Math.PI * 2)
      let d = 12

      function calcDims() {
        const rawW = window.innerWidth
        const h = window.innerHeight
        // For screen widths <= 770px (from 300px to 700px), lock the wheel calculation base to 770px
        // so it appears at the exact same visual scale and size as it does at 770px.
        // For screen widths > 770px, retain existing dynamic viewport scaling.
        const w = rawW <= 770 ? 770 : rawW
        const scale = d / 12
        return {
          rawW,
          w,
          h,
          scale,
          radiusDivisor: 3 / scale,
          minDivisor: 3 / scale,
          wheelRadiusFactor: 0.12 / scale,
          translateZ_px: -26 * (w / 100) * scale,
          perspective_px: w * scale,
        }
      }

      let dims = calcDims()

      let c = {
        rotateX: 70,
        rotateY: -20,
        rotateZ: 0,
        translateX: 0,
        translateY: 0,
      }
      let m = { value: 0 } // gentle drift
      let f = { value: 0 } // scroll spin offset
      let u = { value: 0 } // perspective warp factor

      function updateTransform() {
        const { translateX, translateY, rotateX, rotateY, rotateZ } = c
        const { translateZ_px } = dims
        mediasContainer!.style.transform = `translate3d(${translateX}vw, ${translateY}vw, ${translateZ_px}px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) rotateZ(${rotateZ}deg)`
        mediaEls.forEach((el) => {
          gsap.set(el, {
            rotationX: -rotateX,
            rotationY: -rotateY,
            rotation: -rotateZ,
          })
        })
      }

      function updatePositions() {
        const { w, radiusDivisor, minDivisor, wheelRadiusFactor, perspective_px } = dims
        wheelSection!.style.perspective = `${perspective_px * (1 + 0.3 * u.value)}px`
        const currentAngle = m.value + f.value
        const radius = w / Math.max(minDivisor, radiusDivisor - u.value * wheelRadiusFactor)
        mediaEls.forEach((item, idx) => {
          const angle = currentAngle + angles[idx]
          gsap.set(item, {
            xPercent: -50,
            yPercent: -50,
            x: Math.sin(angle) * radius,
            y: Math.cos(angle) * radius,
          })
        })
      }

      const animEase = { duration: 0.8, ease: 'power3' }
      const quickRotateX = gsap.quickTo(c, 'rotateX', animEase)
      const quickRotateY = gsap.quickTo(c, 'rotateY', animEase)
      const quickRotateZ = gsap.quickTo(c, 'rotateZ', { ...animEase, onUpdate: updateTransform })
      const quickPersp = gsap.quickTo(u, 'value', { duration: 1.3, ease: 'power2.out', onUpdate: updatePositions })
      const quickSpin = gsap.quickTo(f, 'value', { duration: 0.5, ease: 'power2', onUpdate: updatePositions })

      // Interactive Mouse Cursor Tilt Tracking (Tutorial 106)
      function handlePointerMove(clientX: number, clientY: number) {
        const { rawW, h } = dims
        quickRotateY((clientX / rawW) * 50 - 25)
        quickRotateX((clientY / h) * 40 - 20 + 70)
        quickRotateZ(-((clientX / rawW) * 10) + 5)
      }

      window.addEventListener('mousemove', (e) => handlePointerMove(e.clientX, e.clientY), { passive: true })
      window.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches && e.touches[0]) {
            handlePointerMove(e.touches[0].clientX, e.touches[0].clientY)
          }
        },
        { passive: true }
      )

      dims = calcDims()
      updateTransform()
      updatePositions()

      window.addEventListener('resize', () => {
        dims = calcDims()
        updateTransform()
        updatePositions()
      })

      // ScrollTrigger: Whole circular path and each individual 3D fruit model spin in sync with scroll
      let currentModelYaw = 0
      ScrollTrigger.create({
        trigger: '#the-edit-hero-section',
        start: 'top top',
        endTrigger: '#cards-section',
        end: 'bottom bottom',
        scrub: 1.25,
        onUpdate: (self) => {
          // Whole circular path spins in sync with scroll
          quickSpin(self.progress * Math.PI * 4)
          quickPersp(self.progress * 0.5)

          // Each individual 3D fruit model spins on its axis with scroll
          currentModelYaw = self.progress * 720
          iframes.forEach((ifr) => {
            try {
              const win = ifr.contentWindow as any
              if (win && win.ControlsAPI) {
                win.ControlsAPI.set('yaw', currentModelYaw)
              }
            } catch (e) {}
          })
        },
      })

      // Forward wheel events from inside iframes to ensure scroll never gets stuck
      iframes.forEach((ifr) => {
        ifr.addEventListener('load', () => {
          try {
            const win = ifr.contentWindow as any
            if (win && win.ControlsAPI) {
              win.ControlsAPI.set('yaw', currentModelYaw)
            }
            win?.addEventListener(
              'wheel',
              (e: WheelEvent) => {
                window.dispatchEvent(
                  new WheelEvent('wheel', {
                    deltaX: e.deltaX,
                    deltaY: e.deltaY,
                    deltaMode: e.deltaMode,
                    clientX: e.clientX,
                    clientY: e.clientY,
                    bubbles: true,
                    cancelable: true,
                  })
                )
              },
              { passive: true }
            )
          } catch (e) {}
        })
      })
    }

    let luxuryEase: gsap.EaseFunction
    try {
      luxuryEase = CustomEase.create('luxuryEditRipple', '0.16, 1, 0.3, 1')
    } catch (e) {
      luxuryEase = gsap.parseEase('power3.out')
    }

    // A. "THE EDIT" Hero Headline Character Ripple
    const editHeroLines = document.querySelectorAll<HTMLElement>('.edit-hero-heading')
    const editHeroChars = document.querySelectorAll<HTMLElement>('.edit-hero-char')

    gsap.set(editHeroChars, {
      yPercent: 115,
      opacity: 0,
      filter: 'blur(5px)',
    })

    const editHeroTl = gsap.timeline({ delay: 0.1 })
    editHeroLines.forEach((line) => {
      if (line.offsetParent === null) return
      const lineChars = Array.from(line.querySelectorAll<HTMLElement>('.edit-hero-char'))
      const centerIdx = (lineChars.length - 1) / 2

      lineChars.forEach((char, charIdx) => {
        const distFromCenter = Math.abs(charIdx - centerIdx)
        const waveDelay = distFromCenter * 0.024

        editHeroTl.to(
          char,
          {
            yPercent: 0,
            opacity: 1,
            filter: 'blur(0px)',
            duration: 1.6,
            ease: luxuryEase,
          },
          waveDelay
        )
      })
    })

    // B. "WEEK OF [MARCH 4]" & Fruit Cards Animation
    const weekLines = document.querySelectorAll<HTMLElement>('.week-heading')
    const weekChars = document.querySelectorAll<HTMLElement>('.week-heading-char')
    const cards = document.querySelectorAll<HTMLElement>('.fruit-card-anim')

    gsap.set(weekChars, {
      yPercent: 115,
      opacity: 0,
      filter: 'blur(5px)',
    })
    cards.forEach((c) => gsap.set(c, { opacity: 0, x: 50 }))

    const weekTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#cards-section',
        start: 'top 80%',
        once: true,
      },
    })

    weekLines.forEach((line, lineIndex) => {
      const lineChars = Array.from(line.querySelectorAll<HTMLElement>('.week-heading-char'))
      const centerIdx = (lineChars.length - 1) / 2
      const lineStartDelay = lineIndex * 0.095

      lineChars.forEach((char, charIdx) => {
        const distFromCenter = Math.abs(charIdx - centerIdx)
        const waveDelay = lineStartDelay + (distFromCenter * 0.024)

        weekTl.to(
          char,
          {
            yPercent: 0,
            opacity: 1,
            filter: 'blur(0px)',
            duration: 1.6,
            ease: luxuryEase,
          },
          waveDelay
        )
      })
    })

    weekTl.to(
      cards,
      {
        opacity: 1,
        x: 0,
        duration: 1.2,
        stagger: 0.12,
        ease: luxuryEase,
      },
      0.35
    )

    // C. "THIS WEEK'S LEDGER" Headline Character Ripple
    const ledgerLines = document.querySelectorAll<HTMLElement>('.ledger-title-line')
    const ledgerChars = document.querySelectorAll<HTMLElement>('.ledger-title-char')

    gsap.set(ledgerChars, {
      yPercent: 115,
      opacity: 0,
      filter: 'blur(5px)',
    })

    const ledgerTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#ledger-section',
        start: 'top 80%',
        once: true,
      },
    })

    ledgerLines.forEach((line, lineIndex) => {
      const lineChars = Array.from(line.querySelectorAll<HTMLElement>('.ledger-title-char'))
      const centerIdx = (lineChars.length - 1) / 2
      const lineStartDelay = lineIndex * 0.095

      lineChars.forEach((char, charIdx) => {
        const distFromCenter = Math.abs(charIdx - centerIdx)
        const waveDelay = lineStartDelay + (distFromCenter * 0.024)

        ledgerTl.to(
          char,
          {
            yPercent: 0,
            opacity: 1,
            filter: 'blur(0px)',
            duration: 1.6,
            ease: luxuryEase,
          },
          waveDelay
        )
      })
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheEdit)
  } else {
    initTheEdit()
  }
</script>
