                    <span class="gift-hero-char inline-block will-change-transform">I</span>
                    <span class="gift-hero-char inline-block will-change-transform">F</span>
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                  </span>
                </span>
                <span class="block overflow-hidden pb-[0.05em]">
                  <span
                    class="gift-hero-line flex flex-nowrap whitespace-nowrap justify-center will-change-transform uppercase font-display font-semibold text-[80px] sm:text-[100px] leading-[72px] sm:leading-[90px] tracking-[0.8px]"
                    style="background: linear-gradient(180deg, #FBF9D6 0%, #FC558D 100%); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
                    data-line="CRATE"
                  >
                    <span class="gift-hero-char inline-block will-change-transform">C</span>
                    <span class="gift-hero-char inline-block will-change-transform">R</span>
                    <span class="gift-hero-char inline-block will-change-transform">A</span>
                    <span class="gift-hero-char inline-block will-change-transform">T</span>
                    <span class="gift-hero-char inline-block will-change-transform">E</span>
                  </span>
                </span>
              </div>
            </h1>

            <div class="mt-[12px] sm:mt-[20px] overflow-hidden">
              <p
                class="gift-subtext will-change-transform m-0 text-creme text-center font-body text-[14px] sm:text-[16px] font-semibold leading-[17px] sm:leading-[20px] tracking-[-0.4px]"
              >
                Crates for houses you respect.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom spacing container: allows the fruit arrangement in the background to breathe -->
      <div class="relative z-0 w-full h-[180px] sm:h-[220px] md:h-[280px] lg:h-[340px] pointer-events-none" aria-hidden="true"></div>
    </section>

    <!-- Section 2: Three Crate Cards Grid -->
    <section class="w-full bg-[#111111] py-[50px] sm:py-[60px] lg:py-[80px] overflow-hidden">
      <div class="px-4 lg:px-8 w-full">
        <div class="w-full mx-auto flex flex-col">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-[36px] md:gap-[24px] lg:gap-[32px] w-full">
            {
              crateCards.map((crate) => (
                <div class="crate-card flex flex-col w-full will-change-transform transition-all">
                  <!-- Crate Image -->
                  <div class="relative w-full aspect-square rounded-[12px] overflow-hidden select-none bg-[#181818]">
                    <img
                      alt={crate.titleLine1 + ' ' + crate.titleLine2}
                      class="object-cover w-full h-full"
                      src={crate.img}
                      loading="lazy"
