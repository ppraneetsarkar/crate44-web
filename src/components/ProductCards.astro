  class Shared3DViewer {
    scene: THREE.Scene
    camera: THREE.PerspectiveCamera
    renderer: THREE.WebGLRenderer
    roomEnv: RoomEnvironment
    envTexture: THREE.Texture
    pmremGenerator: THREE.PMREMGenerator
    fruitHolder = new THREE.Group()
    modelCache = new Map<string, THREE.Group>()
    currentGroup: THREE.Group | null = null
    activeFile: string = ''
    currentCenterY: number = -0.06
    time: number = 0
    animId: number | null = null
    currentContainer: HTMLElement | null = null
    loader = new GLTFLoader()

    constructor() {
      this.scene = new THREE.Scene()
      this.camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100)
      this.camera.position.set(0, 0, 5.0)

      this.renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' })
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
      this.renderer.toneMapping = THREE.ACESFilmicToneMapping
      this.renderer.toneMappingExposure = 1.76

      this.pmremGenerator = new THREE.PMREMGenerator(this.renderer)
      this.pmremGenerator.compileEquirectangularShader()

      // Dedicated single fruit holder to guarantee zero model overlap/lingering
      this.scene.add(this.fruitHolder)

      // Authentic PolyHaven Broadway Hall studio HDRI from HTML source
      new RGBELoader().load('/3d-fruits/page2/photo_studio_broadway_hall_1k.hdr', (texture) => {
        const envMap = this.pmremGenerator.fromEquirectangular(texture).texture
        this.scene.environment = envMap
        texture.dispose()
      })

      // Studio key, fill & ambient lighting matching HTML source
      const mainLight = new THREE.DirectionalLight(0xffffff, 1.3)
      mainLight.position.set(5, 8, 5)
      this.scene.add(mainLight)

      const fillLight = new THREE.DirectionalLight(0xffffff, 0.6)
      fillLight.position.set(-5, -2, -5)
      this.scene.add(fillLight)

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8)
      this.scene.add(ambientLight)

      this.startLoop()
    }

    startLoop() {
      const loop = () => {
        this.time += 0.016
        this.fruitHolder.position.y = this.currentCenterY + Math.sin(this.time * 2) * 0.04
        this.fruitHolder.rotation.y += 0.008
        this.renderer.render(this.scene, this.camera)
        this.animId = requestAnimationFrame(loop)
      }
      this.animId = requestAnimationFrame(loop)
    }

    reset() {
      this.currentContainer = null
      this.activeFile = ''
      this.currentGroup = null
      this.fruitHolder.clear()
      if (this.renderer.domElement.parentNode) {
        this.renderer.domElement.parentNode.removeChild(this.renderer.domElement)
      }
    }

    attachTo(container: HTMLElement, filename: string) {
      if (!container || !filename) return

      // Always ensure the canvas is mounted inside the active target container
      if (this.renderer.domElement.parentNode !== container) {
        container.appendChild(this.renderer.domElement)
        const w = container.clientWidth || 360
        const h = container.clientHeight || 440
        this.camera.aspect = w / h
        this.camera.updateProjectionMatrix()
        this.renderer.setSize(w, h)
      }
      this.currentContainer = container

      if (this.activeFile === filename && this.currentGroup) return
      this.activeFile = filename

      const cleanFilename = filename.startsWith('/') ? filename.split('/').pop() || filename : filename
      const cfg = FRUIT_CONFIGS[cleanFilename] || { color: '#FFFFFF', rotX: 0, rotY: 0, rotZ: 0, centerY: -0.06 }
      this.currentCenterY = cfg.centerY

      // Clean holder so no previous fruit mesh ever lingers
      this.fruitHolder.clear()
      this.fruitHolder.rotation.y = 0
      this.currentGroup = null

      if (this.modelCache.has(cleanFilename)) {
        this.currentGroup = this.modelCache.get(cleanFilename)!
        this.currentGroup.rotation.y = 0
        this.currentGroup.traverse((child: any) => {
          if (child.isMesh && child.material) {
            const mat = child.material
            mat.roughness = cfg.roughness !== undefined ? cfg.roughness : 0.44
            mat.metalness = cfg.metalness !== undefined ? cfg.metalness : 0.05
            mat.envMapIntensity = cfg.envMapIntensity !== undefined ? cfg.envMapIntensity : 1.0
            mat.needsUpdate = true
          }
        })
        this.fruitHolder.add(this.currentGroup)
        return
      }

      const filePath = filename.startsWith('/') ? filename : `/models/fruits/${cleanFilename}`
      this.loader.load(
        filePath,
        (gltf) => {
          const model = gltf.scene

          // Apply authentic color tint, optional texture & PBR properties from HTML source
          let customMap: THREE.Texture | null = null
          if (cfg.texture) {
            customMap = new THREE.TextureLoader().load(cfg.texture)
            customMap.colorSpace = THREE.SRGBColorSpace
            customMap.flipY = false
            customMap.wrapS = THREE.RepeatWrapping
            customMap.wrapT = THREE.RepeatWrapping
          }

          model.traverse((child: any) => {
            if (child.isMesh && child.material) {
              let mat = child.material
              if (!mat.isMeshStandardMaterial) {
                const oldMat = mat
                mat = new THREE.MeshStandardMaterial({
                  map: oldMat.map || null,
                  color: oldMat.color ? oldMat.color.clone() : new THREE.Color(0xffffff),
                  transparent: oldMat.transparent || false,
                  opacity: oldMat.opacity !== undefined ? oldMat.opacity : 1.0,
                })
                child.material = mat
              }
              if (customMap) {
                mat.map = customMap
                mat.aoMap = null
              }
              if (cfg.color && cfg.color !== '#FFFFFF') {
                mat.color.set(cfg.color)
              }
              mat.roughness = cfg.roughness !== undefined ? cfg.roughness : 0.44
              mat.metalness = cfg.metalness !== undefined ? cfg.metalness : 0.05
              mat.envMapIntensity = cfg.envMapIntensity !== undefined ? cfg.envMapIntensity : 1.0
              mat.needsUpdate = true
            }
          })

          // 1. Set source Euler orientation
          const radX = (cfg.rotX * Math.PI) / 180
          const radY = (cfg.rotY * Math.PI) / 180
          const radZ = (cfg.rotZ * Math.PI) / 180
          model.rotation.set(radX, radY, radZ)
          model.updateMatrixWorld(true)

          // 2. Measure upright bounding box
          const box = new THREE.Box3().setFromObject(model)
          const center = box.getCenter(new THREE.Vector3())
          const size = box.getSize(new THREE.Vector3())
          const maxDim = Math.max(size.x, size.y, size.z) || 1

          // 3. Normalized prominent scale
          const targetScale = 1.95 / maxDim
          model.scale.setScalar(targetScale)
          model.position.sub(center.clone().multiplyScalar(targetScale))

          // 4. Wrap inside pivotGroup for upright continuous spin
          const pivotGroup = new THREE.Group()
          pivotGroup.position.set(0, 0, 0)
          pivotGroup.add(model)

          this.modelCache.set(cleanFilename, pivotGroup)

          // Only mount if this model is still the active card's target
          if (this.activeFile === filename) {
            this.fruitHolder.clear()
            this.currentGroup = pivotGroup
            this.currentGroup.rotation.y = 0
            this.fruitHolder.add(this.currentGroup)
          }
        },
        undefined,
        (err) => {
          console.warn('Failed to load fruit model:', filePath, err)
        }
      )
    }

    resize() {
      if (!this.currentContainer) return
      const w = this.currentContainer.clientWidth || 360
      const h = this.currentContainer.clientHeight || 440
      this.camera.aspect = w / h
      this.camera.updateProjectionMatrix()
      this.renderer.setSize(w, h)
    }

    destroy() {
      if (this.animId) cancelAnimationFrame(this.animId)
      this.renderer.dispose()
      this.roomEnv.dispose()
      this.envTexture.dispose()
      this.pmremGenerator.dispose()
    }
  }

  let sharedViewer: Shared3DViewer | null = null
  let cleanupCarousel: (() => void) | null = null

  function initCarousel() {
    if (cleanupCarousel) {
      cleanupCarousel()
      cleanupCarousel = null
    }

    const stage = document.getElementById('cards-stage')
    if (!stage) return

    const cardElements = Array.from(stage.querySelectorAll('.card-wrapper')) as HTMLElement[]
    const numCards = cardElements.length
    if (numCards === 0) return

    if (!sharedViewer) {
      sharedViewer = new Shared3DViewer()
    }

    const cards = cardElements.map((el) => {
      return {
        el,
        blurOverlay: el.querySelector('.card-blur-overlay') as HTMLElement | null,
        btnWrap: el.querySelector('.card-btn-wrap') as HTMLElement | null,
        marqueeWrap: el.querySelector('.card-marquee-wrap') as HTMLElement | null,
        container3D: el.querySelector('.card-3d-container') as HTMLElement | null,
        wasActive: false,
        currentZ: -1,
        currentOpacity: -1,
      }
    })

    let targetPos = 0
    let currentPos = 0
    let isDragging = false
    let dragStartX = 0
    let dragStartPos = 0
    let winWidth = window.innerWidth
    let isSectionVisible = true
    let isLooping = false
    let rafId: number | null = null

    let lastClientX = 0
    let lastTime = 0
    let velocityX = 0

    const animObj = { pos: 0 }
    let activeTween: gsap.core.Tween | null = null

    const onResize = () => {
      winWidth = window.innerWidth
      if (sharedViewer) sharedViewer.resize()
      updateCards(currentPos)
    }
    window.addEventListener('resize', onResize, { passive: true })

    const updateCards = (L: number) => {
      const isSm = winWidth < 640
      const isMd = winWidth >= 640 && winWidth < 768
      const isLg = winWidth >= 768 && winWidth < 1024

      const btnActiveY = isSm ? -24 : isMd ? -28 : -32

      let closestIndex = -1
      let minAbsR = 999

      for (let l = 0; l < numCards; l++) {
        let r = ((l - L) % numCards + numCards) % numCards
        if (r > numCards / 2) {
          r -= numCards
        }

        const sign = Math.sign(r)
        const absR = Math.abs(r)

        if (absR < minAbsR) {
          minAbsR = absR
          closestIndex = l
        }

        const posX = sign * (
          Math.min(1, absR) * (isSm ? 260 : isMd ? 300 : isLg ? 360 : 440) +
          Math.max(0, absR - 1) * (isSm ? 230 : isMd ? 260 : isLg ? 310 : 375)
        )
        const scale = Math.max(
          0.65,
          1 - (1 - 0.78788) * Math.min(1, absR) - 0.12 * Math.max(0, absR - 1)
        )
        const zIndex = Math.round(30 - 5 * absR)
        const opacity = absR > 2.2 ? Math.max(0, 1 - (absR - 2.2) * 2) : 1
        const isActive = absR < 0.45

        const card = cards[l]
        card.el.style.transform = `translate3d(${posX}px, 0px, 0px) scale(${scale})`

        if (card.currentZ !== zIndex) {
          card.currentZ = zIndex
          card.el.style.zIndex = `${zIndex}`
        }

        const roundedOp = Math.round(opacity * 100) / 100
        if (card.currentOpacity !== roundedOp) {
          card.currentOpacity = roundedOp
          card.el.style.opacity = `${roundedOp}`
          card.el.style.pointerEvents = roundedOp < 0.2 ? 'none' : 'auto'
        }

        if (card.wasActive !== isActive) {
          card.wasActive = isActive

          if (card.blurOverlay) {
            card.blurOverlay.style.display = isActive ? 'block' : 'none'
            card.blurOverlay.style.opacity = isActive ? '1' : '0'
          }

          if (card.btnWrap) {
            card.btnWrap.style.transform = isActive
              ? `translate3d(0px, ${btnActiveY}px, 0px)`
              : 'translate3d(0px, 0px, 0px)'
          }

          if (card.marqueeWrap) {
            card.marqueeWrap.style.display = isActive ? 'inline-flex' : 'none'
            card.marqueeWrap.style.opacity = isActive ? '1' : '0'
          }
        }
      }

      // Attach single Three.js viewer to active middle card (1 WebGL context total, 0 mobile crashes!)
      if (closestIndex >= 0 && minAbsR < 0.75 && sharedViewer) {
        const activeCard = cards[closestIndex]
        if (activeCard && activeCard.container3D) {
          const file = activeCard.container3D.getAttribute('data-3d-file')
          if (file) {
            sharedViewer.attachTo(activeCard.container3D, file)
          }
        }
      }
    }

    const startLoop = () => {
      if (!isLooping && isSectionVisible) {
        isLooping = true
        rafId = requestAnimationFrame(loop)
      }
    }

    const loop = () => {
      if (!isSectionVisible || !isDragging) {
        isLooping = false
        rafId = null
        return
      }

      currentPos += (targetPos - currentPos) * 0.45
      updateCards(currentPos)

      rafId = requestAnimationFrame(loop)
    }

    const stageObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isSectionVisible = entry.isIntersecting
          if (isSectionVisible) {
            updateCards(currentPos)
          } else {
            if (activeTween) {
              activeTween.kill()
              activeTween = null
            }
            if (rafId) {
              cancelAnimationFrame(rafId)
              rafId = null
            }
            isLooping = false
          }
        })
      },
      { rootMargin: '100px 0px' }
    )
    stageObserver.observe(stage)

    const onPointerDown = (e: PointerEvent) => {
      const target = e.target as HTMLElement
      if (target.closest('.card-order-btn')) return

      if (activeTween) {
        activeTween.kill()
        activeTween = null
      }

      isDragging = true
      stage.style.cursor = 'grabbing'
      dragStartX = e.clientX || 0
      dragStartPos = currentPos
      targetPos = currentPos
      lastClientX = dragStartX
      lastTime = performance.now()
      velocityX = 0

      startLoop()

      window.addEventListener('pointermove', onPointerMove, { passive: true })
      window.addEventListener('pointerup', onPointerUp)
      window.addEventListener('pointercancel', onPointerUp)
    }

    const onPointerMove = (e: PointerEvent) => {
      if (!isDragging) return
      const clientX = e.clientX || 0
      const now = performance.now()
      const dt = now - lastTime

      if (dt > 8) {
        const delta = clientX - lastClientX
        const dragFactor = winWidth < 768 ? 260 : 380
        velocityX = -(delta / dragFactor) / dt
        lastClientX = clientX
        lastTime = now
      }

      const totalDeltaX = clientX - dragStartX
      const dragFactor = winWidth < 768 ? 260 : 380
      targetPos = dragStartPos - totalDeltaX / dragFactor
      startLoop()
    }

    const onPointerUp = () => {
      if (!isDragging) return
      isDragging = false
      stage.style.cursor = 'grab'

      window.removeEventListener('pointermove', onPointerMove)
      window.removeEventListener('pointerup', onPointerUp)
      window.removeEventListener('pointercancel', onPointerUp)

      if (rafId) {
        cancelAnimationFrame(rafId)
        rafId = null
      }
      isLooping = false

      let snapTarget = Math.round(targetPos)
      const speed = Math.abs(velocityX)

      if (speed > 0.0008) {
        const flickDir = Math.sign(velocityX)
        snapTarget = Math.round(targetPos + flickDir * 0.45)
      }

      animObj.pos = currentPos
      if (activeTween) activeTween.kill()

      const dist = Math.abs(snapTarget - currentPos)
      const duration = Math.min(0.72, Math.max(0.42, 0.38 + dist * 0.2))

      activeTween = gsap.to(animObj, {
        pos: snapTarget,
        duration: duration,
        ease: 'power3.out',
        onUpdate: () => {
          currentPos = animObj.pos
          targetPos = animObj.pos
          updateCards(currentPos)
        },
        onComplete: () => {
          currentPos = snapTarget
          targetPos = snapTarget
          updateCards(currentPos)
          activeTween = null
        },
      })
    }

    stage.addEventListener('pointerdown', onPointerDown)

    const cardClickHandlers: { el: HTMLElement; fn: (e: MouseEvent) => void }[] = []
    cards.forEach((card, idx) => {
      const clickHandler = (e: MouseEvent) => {
        const target = e.target as HTMLElement
        if (target.closest('.card-order-btn')) return

        let r = ((idx - currentPos) % numCards + numCards) % numCards
        if (r > numCards / 2) r -= numCards

        if (Math.abs(r) < 0.2) return
        e.preventDefault()

        const snapTarget = Math.round(currentPos + r)

        if (rafId) {
          cancelAnimationFrame(rafId)
          rafId = null
        }
        isLooping = false

        animObj.pos = currentPos
        if (activeTween) activeTween.kill()

        activeTween = gsap.to(animObj, {
          pos: snapTarget,
          duration: 0.65,
          ease: 'power3.out',
          onUpdate: () => {
            currentPos = animObj.pos
            targetPos = animObj.pos
            updateCards(currentPos)
          },
          onComplete: () => {
            currentPos = snapTarget
            targetPos = snapTarget
            updateCards(currentPos)
            activeTween = null
          },
        })
      }
      card.el.addEventListener('click', clickHandler)
      cardClickHandlers.push({ el: card.el, fn: clickHandler })
    })

    // Initial update
    updateCards(0)

    cleanupCarousel = () => {
      window.removeEventListener('resize', onResize)
      stage.removeEventListener('pointerdown', onPointerDown)
      window.removeEventListener('pointermove', onPointerMove)
      window.removeEventListener('pointerup', onPointerUp)
      window.removeEventListener('pointercancel', onPointerUp)
      cardClickHandlers.forEach(({ el, fn }) => el.removeEventListener('click', fn))
      stageObserver.disconnect()
      if (activeTween) activeTween.kill()
      if (rafId) cancelAnimationFrame(rafId)
    }
  }

  function initMorphButtons() {
    document.querySelectorAll<HTMLElement>('.product-btn-morph').forEach((btn) => {
      const textTop = btn.querySelector<HTMLElement>('.roll-text-top')
      const textBottom = btn.querySelector<HTMLElement>('.roll-text-bottom')

      gsap.set(btn, {
        borderTopLeftRadius: '25px',
        borderBottomLeftRadius: '25px',
        borderTopRightRadius: '25px',
        borderBottomRightRadius: '25px',
      })

      if (textTop && textBottom) {
        gsap.set(textTop, { yPercent: 0, filter: 'blur(0px)' })
        gsap.set(textBottom, { yPercent: 100, filter: 'blur(3.5px)' })
      }

      btn.addEventListener('mouseenter', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '12px',
          borderBottomLeftRadius: '12px',
          borderTopRightRadius: '12px',
          borderBottomRightRadius: '12px',
          duration: 0.45,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: -100, filter: 'blur(3.5px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 0, filter: 'blur(0px)', duration: 0.42, ease: 'power3.out', overwrite: 'auto' })
        }
      })

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          borderTopLeftRadius: '25px',
          borderBottomLeftRadius: '25px',
          borderTopRightRadius: '25px',
          borderBottomRightRadius: '25px',
          duration: 0.38,
          ease: 'power3.out',
          overwrite: 'auto',
        })

        if (textTop && textBottom) {
          gsap.to(textTop, { yPercent: 0, filter: 'blur(0px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
          gsap.to(textBottom, { yPercent: 100, filter: 'blur(3.5px)', duration: 0.38, ease: 'power3.out', overwrite: 'auto' })
        }
      })
    })
  }

  async function loadFruitsFromSheet() {
    try {
      const res = await fetch(`${SHEET_CSV_URL}&t=${Date.now()}`)
      if (!res.ok) return
      const text = await res.text()
      if (!text.toLowerCase().includes('visible_on_site')) return

      const rows = parseCSV(text)
      const visibleRows = rows.filter((r) => {
        const val = String(r.visible_on_site || '').trim().toLowerCase()
        return val === 'true' || val === '1' || val === 'yes'
      })

      if (visibleRows.length === 0) return

      const newFruits: FruitCard[] = visibleRows.map((r) => {
        const inStockVal = String(r.in_stock || '').trim().toLowerCase()
        const inStock = inStockVal === 'true' || inStockVal === '1' || inStockVal === 'yes'
        return {
          id: r.id || `${r.title_line_1}-${r.title_line_2}`.toLowerCase().replace(/\s+/g, '-'),
          titleLine1: r.title_line_1 || '',
          titleLine2: r.title_line_2 || '',
          price: r.price || '',
          inStock,
          windowText: r.window_text || '',
          threeDFile: r['3d_file'] || '',
        }
      })

      const stage = document.getElementById('cards-stage')
      if (!stage || newFruits.length === 0) return

      const existingCards = Array.from(stage.querySelectorAll<HTMLElement>('.card-wrapper'))
      const existingIds = existingCards.map((c) => c.getAttribute('data-fruit-id') || '')
      const newIds = newFruits.map((f) => f.id)
      const isSameStructure = existingIds.length === newIds.length && existingIds.every((id, idx) => id === newIds[idx])

      if (isSameStructure) {
        // In-place updates: Keeps 3D canvas, GSAP state, and current carousel view 100% intact!
        newFruits.forEach((fruit, idx) => {
          const card = existingCards[idx]
          if (!card) return

          // Update titles
          const titleP1 = card.querySelector<HTMLParagraphElement>('div.font-display > p:first-child')
          const titleP2 = card.querySelector<HTMLParagraphElement>('div.font-display > p:last-child')
          if (titleP1 && titleP1.textContent !== fruit.titleLine1) titleP1.textContent = fruit.titleLine1
          if (titleP2 && titleP2.textContent !== fruit.titleLine2) titleP2.textContent = fruit.titleLine2

          // Update Price badge
          const priceSpan = card.querySelector<HTMLSpanElement>('.card-price-badge > span')
          if (priceSpan && priceSpan.textContent !== fruit.price) priceSpan.textContent = fruit.price

          // Update Marquee window text
          const marqueeSpans = card.querySelectorAll<HTMLSpanElement>('.card-marquee-scroll span')
          marqueeSpans.forEach((s) => {
            if (s.textContent !== fruit.windowText) s.textContent = fruit.windowText
          })

          // Update CTA button & In-Stock status
          const btn = card.querySelector<HTMLAnchorElement>('.card-order-btn')
          if (btn) {
            const btnText = fruit.inStock ? 'ORDER NOW' : 'OUT OF STOCK'
            const btnHref = fruit.inStock
              ? `https://wa.me/?text=Hi%20Crate44%2C%20I%20would%20like%20to%20order%20${encodeURIComponent(fruit.titleLine1 + ' ' + fruit.titleLine2)}`
              : '#'
            if (btn.getAttribute('href') !== btnHref) btn.setAttribute('href', btnHref)
            if (fruit.inStock) {
              btn.setAttribute('target', '_blank')
              btn.setAttribute('rel', 'noopener noreferrer')
              btn.classList.remove('bg-[#FBF9D6]', 'text-[#5B0000]', 'border-[#FBF9D6]', 'cursor-not-allowed', 'opacity-95')
              btn.classList.add('bg-[#F8FE03]', 'text-[#131313]', 'border-[#F8FE03]', 'hover:brightness-105', 'active:scale-95')
            } else {
              btn.removeAttribute('target')
              btn.removeAttribute('rel')
              btn.classList.remove('bg-[#F8FE03]', 'text-[#131313]', 'border-[#F8FE03]', 'hover:brightness-105', 'active:scale-95')
              btn.classList.add('bg-[#FBF9D6]', 'text-[#5B0000]', 'border-[#FBF9D6]', 'cursor-not-allowed', 'opacity-95')
            }

            const rollTop = btn.querySelector<HTMLSpanElement>('.roll-text-top')
            const rollBottom = btn.querySelector<HTMLSpanElement>('.roll-text-bottom')
            if (rollTop && rollTop.textContent?.trim() !== btnText) rollTop.textContent = btnText
            if (rollBottom && rollBottom.textContent?.trim() !== btnText) rollBottom.textContent = btnText
          }

          // Update 3D file attribute if modified in Google Sheet
          const container3D = card.querySelector<HTMLElement>('.card-3d-container')
          if (container3D && container3D.getAttribute('data-3d-file') !== fruit.threeDFile) {
            container3D.setAttribute('data-3d-file', fruit.threeDFile)
            if (sharedViewer && sharedViewer.currentContainer === container3D) {
              sharedViewer.attachTo(container3D, fruit.threeDFile)
            }
          }
        })
      } else {
        // Clean rebuild if list of fruits was added/removed
        if (sharedViewer) sharedViewer.reset()
        stage.innerHTML = newFruits.map((f, i) => renderCardHTML(f, i)).join('')
        initCarousel()
        initMorphButtons()
      }
    } catch (err) {
      console.warn('Google Sheet CMS fetch bypassed, using default cards.', err)
    }
  }

  // Expose global manual trigger for testing / immediate sync
  ;(window as any).__refreshFruitsFromSheet = loadFruitsFromSheet

  function start() {
    initCarousel()
    initMorphButtons()
    loadFruitsFromSheet()
    // Background polling every 25 seconds for live spreadsheet updates
    setInterval(loadFruitsFromSheet, 25000)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start)
  } else {
    start()
  }
</script>
